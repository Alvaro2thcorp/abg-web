---
// La pieza estrella de cada línea, en pequeño y funcionando. Datos de ejemplo.
import type { Lang, LineKey } from '../i18n';
interface Props { k: LineKey; lang: Lang; uid?: string }
const { k, lang, uid = k } = Astro.props;
const es = lang === 'es';

// Selector: 4 plantas × 4 viviendas. s = disponible, r = reservada, v = vendida
const floors = [
  ['4', ['s', 'r', 's', 's']],
  ['3', ['v', 's', 'r', 's']],
  ['2', ['s', 's', 'v', 's']],
  ['1', ['v', 's', 's', 'r']],
] as const;
const letters = ['A', 'B', 'C', 'D'];
const dorms = [2, 3, 3, 2];
const m2 = [78, 96, 104, 82];
const label = { s: es ? 'disponible' : 'available', r: es ? 'reservada' : 'reserved', v: es ? 'vendida' : 'sold' };
const unitText = (f: string, i: number, st: 's' | 'r' | 'v') =>
  `${f}${letters[i]} · ${dorms[i]} ${es ? 'dormitorios' : 'bedrooms'} · ${m2[i] + Number(f)} m² · ${es ? 'terraza' : 'terrace'} ${12 + i * 3} m² · ${label[st]}`;

const pf = [
  { src: '/img/foto/muros-1280.webp', t: es ? 'Casa en Altea' : 'House in Altea', c: es ? 'Vivienda unifamiliar · 240 m² · 2025' : 'Single-family home · 240 m² · 2025', alt: es ? 'Volúmenes blancos contra el cielo' : 'White volumes against the sky' },
  { src: '/img/foto/escalera-1280.webp', t: es ? 'Reforma en Jávea' : 'Renovation in Jávea', c: es ? 'Interiorismo · 120 m² · 2024' : 'Interior design · 120 m² · 2024', alt: es ? 'Escalera interior encalada' : 'Plastered interior staircase' },
  { src: '/img/foto/pasarela-1280.webp', t: es ? 'Centro cultural' : 'Cultural centre', c: es ? 'Equipamiento · 1.800 m² · 2023' : 'Public building · 1,800 m² · 2023', alt: es ? 'Pasarela entre muros de hormigón' : 'Walkway between concrete walls' },
];
---
{k === 'promotoras' && (
  <div class="pc pc-units" data-units>
    <div class="pc-bld" role="group" aria-label={es ? 'Viviendas por planta' : 'Units by floor'}>
      {floors.map(([f, sts]) => (
        <div class="pc-floor"><span class="pc-fl">P{f}</span>
          {sts.map((st, i) => <button type="button" class={`u u-${st}`} data-u={unitText(f, i, st)} aria-pressed={f === '3' && i === 1 ? 'true' : 'false'} aria-label={`${f}${letters[i]}, ${label[st]}`}>{f}{letters[i]}</button>)}
        </div>
      ))}
    </div>
    <p class="pc-out" data-unit-out aria-live="polite">{unitText('3', 1, 's')}</p>
    <p class="pc-legend"><span class="d d-s"></span>{label.s}<span class="d d-r"></span>{label.r}<span class="d d-v"></span>{label.v}</p>
  </div>
)}
{k === 'arquitectura' && (
  <div class="pc pc-pf" data-pf>
    <div class="pc-pf-main"><img data-pf-main src={pf[0].src} alt={pf[0].alt} width="1280" height="1920" loading="lazy" decoding="async" /></div>
    <div class="pc-pf-side">
      {pf.map((p, i) => <button type="button" data-src={p.src} data-alt={p.alt} data-cap={`${p.t} · ${p.c}`} aria-pressed={i === 0 ? 'true' : 'false'}><b>{p.t}</b><span>{p.c}</span></button>)}
      <p class="pc-cap" data-pf-cap aria-live="polite">{pf[0].t} · {pf[0].c}</p>
    </div>
  </div>
)}
{k === 'reformas' && (
  <div class="pc pc-ba" data-ba style="--p:50%">
    <img class="pc-before" src="/img/foto/sala-1280.webp" alt={es ? 'Antes: estancia en obra, con paredes de hormigón visto' : 'Before: room under construction with bare concrete'} width="1280" height="857" loading="lazy" decoding="async" />
    <div class="pc-after"><img src="/img/foto/escalera-exterior-1280.webp" alt={es ? 'Después: espacio terminado con escalera y luz natural' : 'After: finished space with staircase and natural light'} width="1280" height="840" loading="lazy" decoding="async" /></div>
    <span class="pc-line" aria-hidden="true"></span>
    <span class="pc-tag l">{es ? 'Antes' : 'Before'}</span><span class="pc-tag r">{es ? 'Después' : 'After'}</span>
    <label class="visually-hidden" for={`ba-${uid}`}>{es ? 'Deslizar entre antes y después' : 'Slide between before and after'}</label>
    <input id={`ba-${uid}`} type="range" min="0" max="100" value="50" />
  </div>
)}
{k === 'inmobiliarias' && (
  <form class="pc pc-val" data-val>
    <div class="pc-row">
      <label>{es ? 'Zona' : 'Area'}
        <select name="zona">
          <option value="2900">{es ? 'Alicante centro' : 'Alicante centre'}</option>
          <option value="3600" selected>{es ? 'Playa de San Juan' : 'San Juan beach'}</option>
          <option value="4200">Altea</option>
          <option value="4500">Jávea</option>
        </select>
      </label>
      <label>{es ? 'Superficie (m²)' : 'Size (m²)'}<input name="m2" type="number" inputmode="numeric" min="30" max="600" value="92" /></label>
    </div>
    <label class="pc-check"><input name="terraza" type="checkbox" checked /> {es ? 'Terraza o vistas al mar' : 'Terrace or sea views'}</label>
    <div class="pc-res"><span>{es ? 'Valoración orientativa' : 'Estimated value'}</span><output data-val-out>—</output></div>
    <button class="btn" type="submit" tabindex="-1" aria-hidden="true" style="pointer-events:none">{es ? 'Recibir el informe completo' : 'Get the full report'}</button>
  </form>
)}

<style>
  .pc{width:100%;max-width:460px;margin-inline:auto;font-size:14px}
  /* selector */
  .pc-bld{display:grid;gap:6px;background:var(--blanco);padding:14px;box-shadow:0 0 0 1px var(--filete)}
  .pc-floor{display:grid;grid-template-columns:28px repeat(4,1fr);gap:6px;align-items:center}
  .pc-fl{font-size:12px;color:var(--gris)}
  .u{height:40px;border:0;cursor:pointer;font-size:13px;font-variant-numeric:tabular-nums;transition:background var(--t-ui),box-shadow var(--t-ui)}
  .u-s{background:var(--hormigon)} .u-s:hover{background:#d6d5d0}
  .u-r{background:repeating-linear-gradient(135deg,var(--hormigon) 0 5px,var(--filete) 5px 6px);color:var(--gris)}
  .u-v{background:var(--tinta);color:#8f8e8a}
  .u[aria-pressed=true]{box-shadow:0 0 0 2px var(--acero);background:var(--acero-suave);color:var(--tinta)}
  .pc-out{margin-top:14px;padding:12px 14px;background:var(--blanco);border-left:2px solid var(--acero);font-variant-numeric:tabular-nums;min-height:46px}
  .pc-legend{display:flex;flex-wrap:wrap;align-items:center;gap:6px 6px;margin-top:10px;color:var(--gris);font-size:12.5px}
  .d{display:inline-block;width:12px;height:12px;margin-left:8px}.d:first-child{margin-left:0}
  .d-s{background:var(--hormigon);box-shadow:inset 0 0 0 1px var(--filete)}.d-r{background:repeating-linear-gradient(135deg,var(--hormigon) 0 3px,var(--filete) 3px 4px)}.d-v{background:var(--tinta)}
  /* portfolio */
  .pc-pf{display:grid;grid-template-columns:1.1fr 1fr;gap:12px;max-width:520px}
  .pc-pf-main{aspect-ratio:3/4;overflow:hidden;background:var(--hormigon)}
  .pc-pf-main img{width:100%;height:100%;object-fit:cover}
  .pc-pf-side{display:flex;flex-direction:column;gap:6px}
  .pc-pf-side button{text-align:left;background:var(--blanco);border:0;padding:12px;cursor:pointer;box-shadow:inset 0 0 0 1px var(--filete);transition:box-shadow var(--t-ui)}
  .pc-pf-side button b{display:block;font-weight:500}
  .pc-pf-side button span{font-size:12.5px;color:var(--gris)}
  .pc-pf-side button[aria-pressed=true]{box-shadow:inset 0 0 0 1px var(--acero),inset 3px 0 0 var(--acero)}
  .pc-cap{margin-top:auto;font-size:12.5px;color:var(--gris)}
  /* antes / después */
  .pc-ba{position:relative;aspect-ratio:3/2;overflow:hidden;background:var(--hormigon);max-width:560px;touch-action:pan-y}
  .pc-ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pc-before{filter:grayscale(1) contrast(.9) brightness(.92)}
  .pc-after{position:absolute;inset:0;clip-path:inset(0 0 0 var(--p))}
  .pc-line{position:absolute;top:0;bottom:0;left:var(--p);width:2px;margin-left:-1px;background:var(--acero);pointer-events:none}
  .pc-line::after{content:"";position:absolute;top:50%;left:-8px;width:18px;height:18px;background:var(--acero);transform:translateY(-50%)}
  .pc-tag{position:absolute;bottom:10px;font-size:12px;background:var(--papel);padding:3px 8px}
  .pc-tag.l{left:10px}.pc-tag.r{right:10px}
  .pc-ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
  .pc-ba input:focus-visible~.pc-line{box-shadow:0 0 0 3px var(--acero-suave)}
  /* valorador */
  .pc-val{display:grid;gap:12px;background:var(--blanco);padding:18px;box-shadow:0 0 0 1px var(--filete)}
  .pc-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .pc-val label{display:grid;gap:6px;color:var(--gris);font-size:13px}
  .pc-val select,.pc-val input[type=number]{font:inherit;font-size:16px;color:var(--tinta);background:var(--papel);border:1px solid var(--filete);border-radius:0;padding:10px 12px;width:100%}
  .pc-check{display:flex!important;grid-template-columns:none;align-items:center;gap:8px!important;color:var(--tinta)!important}
  .pc-check input{accent-color:var(--acero);width:16px;height:16px}
  .pc-res{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;border-top:1px solid var(--tinta);padding-top:12px}
  .pc-res span{color:var(--gris)}
  .pc-res output{font-family:var(--wide);font-weight:500;font-size:20px;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
  .pc-val .btn{justify-content:center;opacity:.9}
  @media (max-width:420px){.pc-pf{grid-template-columns:1fr}.pc-pf-main{aspect-ratio:4/3}.pc-row{grid-template-columns:1fr}}
</style>
