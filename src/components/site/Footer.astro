---
const year = new Date().getFullYear();
const wa = `https://wa.me/34601058997?text=${encodeURIComponent("Hola, quiero hablar de mi web con ABG Frame.")}`;
---

<footer class="pie">
  <div class="abg-wrap">
    <div class="pie__cta">
      <h2>¿Hablamos de <em>tu web?</em></h2>
      <div class="pie__botones">
        <a class="abg-btn abg-btn--coral" href={wa} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
        <a class="abg-btn abg-btn--ghost-night" href="/contacto/">Pedir diagnóstico gratis</a>
      </div>
    </div>

    <div class="pie__cols">
      <div class="pie__marca">
        <p class="pie__logo">ABG Frame</p>
        <p>Estudio web en San Juan de Alicante. Webs para despachos profesionales y negocios, con precio cerrado, entregadas en una semana y cuidadas cada mes.</p>
      </div>
      <nav aria-label="Páginas">
        <p class="pie__titulo">Páginas</p>
        <ul>
          <li><a href="/servicios/">Servicios y precios</a></li>
          <li><a href="/proyectos/">Ejemplos</a></li>
          <li><a href="/sobre-nosotros/">El estudio</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </nav>
      <div>
        <p class="pie__titulo">Contacto</p>
        <ul>
          <li><a href="mailto:contacto@abgframe.com">contacto@abgframe.com</a></li>
          <li><a href="tel:+34601058997">601 05 89 97</a></li>
          <li>San Juan de Alicante</li>
          <li><a href="https://instagram.com/abgframe" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        </ul>
      </div>
    </div>

    <p class="pie__legal">© {year} ABG Frame · Álvaro Bergillos</p>
  </div>
</footer>

<style>
  .pie { background: var(--night); color: var(--on-night); padding-block: clamp(4rem, 8vw, 7rem) 2.5rem; }
  .pie__cta {
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 2rem;
    padding-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid var(--line-night);
  }
  .pie__cta h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2.6rem, 7vw, 5.6rem); letter-spacing: -0.03em; line-height: 0.95; margin: 0; }
  .pie__cta h2 em { font-style: italic; color: #EE6A4D; }
  .pie__botones { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .pie__cols { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; padding-block: clamp(2.5rem, 5vw, 4rem); }
  .pie__logo { font-family: var(--font-display); font-size: 1.6rem; letter-spacing: -0.01em; margin: 0 0 0.9rem; color: var(--on-night); }
  .pie__marca p { font-family: var(--font-body); font-size: 0.95rem; line-height: 1.6; color: var(--on-night-2); margin: 0; max-width: 34ch; }
  .pie__titulo { font-family: var(--font-body); font-weight: 500; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-night-2); margin: 0 0 1.1rem; }
  .pie ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; font-family: var(--font-body); font-size: 0.97rem; color: var(--on-night); }
  .pie a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s ease, color 0.2s ease; }
  .pie ul a:hover { border-color: var(--on-night); }
  .pie a:focus-visible { outline: 2px solid #EE6A4D; outline-offset: 3px; }
  .pie__legal { font-family: var(--font-body); font-size: 0.8rem; color: var(--on-night-2); margin: 0; padding-top: 1.75rem; border-top: 1px solid var(--line-night); }
  @media (max-width: 760px) {
    .pie__cols { grid-template-columns: minmax(0, 1fr); gap: 2.25rem; }
    .pie__botones { width: 100%; flex-direction: column; }
    .pie__botones .abg-btn { width: 100%; }
  }
</style>
