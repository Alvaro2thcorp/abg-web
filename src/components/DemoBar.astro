---
// Barra fina encima de cada demo: deja claro que es un proyecto ficticio de ABGFRAME y lleva a pedir una igual.
import { r, type Lang } from '../i18n';
interface Props { lang: Lang; sector: string; tipo: string }
const { lang, sector, tipo } = Astro.props;
const es = lang === 'es';
---
<div class="dbar" role="banner">
  <a class="dbar__logo" href={r('home', lang)} aria-label="ABGFRAME"><img src="/img/abgframe-logo-color-negativo.svg" alt="ABGFRAME" width="120" height="24" /></a>
  <p class="dbar__t"><span class="dbar__k">Demo</span> {es ? `Web para ${sector}` : `Website for ${sector}`} <span class="dbar__f">· {es ? 'proyecto ficticio, datos de ejemplo' : 'fictional project, sample data'}</span></p>
  <nav class="dbar__nav">
    <a href={r('demo', lang)}>{es ? 'Todas las demos' : 'All demos'}</a>
    <a class="dbar__cta" href={`${r('contacto', lang)}?tipo=${tipo}#form`} data-track="demo_cta">{es ? 'Quiero una así' : 'I want one like this'}</a>
  </nav>
</div>
<style>
  .dbar{position:sticky;top:0;z-index:70;display:flex;align-items:center;gap:16px;min-height:48px;padding:6px max(16px,env(safe-area-inset-left));background:#151515;color:#F3F2EF;font-size:13px}
  .dbar__logo img{display:block;width:104px;height:auto}
  .dbar__t{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .dbar__k{display:inline-block;padding:2px 7px;margin-right:6px;background:#45627F;color:#fff;font-weight:500;font-size:12px;letter-spacing:.02em}
  .dbar__f{color:#A9A8A3}
  .dbar__nav{display:flex;gap:14px;align-items:center}
  .dbar__nav a{color:#F3F2EF;text-decoration:none;white-space:nowrap}
  .dbar__nav a:hover{text-decoration:underline}
  .dbar__cta{padding:7px 12px;background:#F3F2EF;color:#151515!important;font-weight:500}
  .dbar__cta:hover{text-decoration:none!important;background:#fff}
  @media (max-width:760px){.dbar__f,.dbar__nav a:not(.dbar__cta){display:none}.dbar__logo img{width:88px}}
</style>
