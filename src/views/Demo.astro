---
// Índice de demos: una web de ejemplo por sector, lista para enseñar en una tablet o un móvil.
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Sel from '../components/Sel.astro';
import { r, ui, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const t = ui[lang];
const crumbs = [{ name: t.breadcrumbHome, href: r('home', lang) }, { name: 'Demos', href: r('demo', lang) }];
const demos = [
  { k: 'demoPromotora', n: '01', brand: 'Residencial Alba', sector: es ? 'Promotoras y obra nueva' : 'Developers and new builds', d: es ? 'El edificio en 3D: tocas una vivienda y ves su plano, metros, orientación, estado y precio. Sol según la hora, filtros, reserva de visita y tres idiomas.' : 'The building in 3D: tap a home to see its plan, size, orientation, status and price. Sun by the hour, filters, viewing booking and three languages.', tags: es ? ['Edificio 3D', 'Disponibilidad en vivo', 'ES · EN · DE'] : ['3D building', 'Live availability', 'ES · EN · DE'] },
  { k: 'demoEstudio', n: '02', brand: 'Estudio Llum', sector: es ? 'Arquitectura e interiorismo' : 'Architecture and interiors', d: es ? 'Una web editorial: proyectos con ficha técnica, planos que se dibujan solos, maqueta 3D por plantas y un briefing guiado que termina en reunión.' : 'An editorial website: projects with fact sheets, drawings that draw themselves, a 3D model floor by floor and a guided brief that ends in a meeting.', tags: es ? ['Portfolio editorial', 'Maqueta 3D', 'Briefing guiado'] : ['Editorial portfolio', '3D model', 'Guided brief'] },
  { k: 'demoReformas', n: '03', brand: 'Reformas Llevant', sector: es ? 'Constructoras y reformas' : 'Builders and renovation', d: es ? 'Configura tu baño en 3D: eliges azulejo, suelo y mueble, y el presupuesto orientativo cambia al momento. Antes y después, visita 360º y plazos.' : 'Configure your bathroom in 3D: choose tiles, floor and vanity and the estimate updates instantly. Before and after, 360º tour and timelines.', tags: es ? ['Configurador 3D', 'Presupuesto en vivo', 'Visita 360º'] : ['3D configurator', 'Live estimate', '360º tour'] },
  { k: 'demoInmobiliaria', n: '04', brand: 'Casa Marina', sector: es ? 'Inmobiliarias' : 'Real estate agencies', d: es ? 'Buscador sobre el mapa de la Costa Blanca, fichas con visita 360º y calculadora de hipoteca, y un valorador que capta propietarios que quieren vender.' : 'Search on a map of the Costa Blanca, listings with 360º tours and a mortgage calculator, and a valuation tool that wins sellers.', tags: es ? ['Mapa interactivo', 'Visita 360º', 'Valorador'] : ['Interactive map', '360º tour', 'Valuation tool'] },
] as const;
---
<Base lang={lang} noindex route="demo" breadcrumbs={crumbs}
  title={es ? 'Demos: una web de ejemplo para cada sector | ABGFRAME' : 'Demos: a sample website for each sector | ABGFRAME'}
  description={es ? 'Cuatro webs de ejemplo, una por sector: promotora, estudio de arquitectura, reformas e inmobiliaria. Interactivas, con 3D y listas para probar.' : 'Four sample websites, one per sector: developer, architecture studio, renovation and real estate agency. Interactive, with 3D, ready to try.'}>
  <Crumbs items={crumbs} />
  <section class="phero">
    <div class="wrap">
      <span class="kick">{es ? 'Demos · proyectos ficticios' : 'Demos · fictional projects'}</span>
      <h1 class="h1">{es ? 'Así sería la web de tu negocio.' : 'This is what your business website could be.'}</h1>
      <p class="lead">{es ? 'Cuatro webs de ejemplo, una por sector. Los negocios son inventados; las piezas son las que hacemos de verdad. Ábrelas en el móvil y tócalo todo.' : 'Four sample websites, one per sector. The businesses are invented; the pieces are the ones we really build. Open them on your phone and try everything.'}{!es && ' (The demos are in Spanish; the developer one also switches to English and German.)'}</p>
    </div>
  </section>
  <section class="sec--tight" style="padding-top:0">
    <div class="wrap dm">
      {demos.map((d) => (
        <a class="dm__c" href={r(d.k, 'es')} data-track={`demo_${d.k}`}>
          <Sel as="figure" class="dm__fig" draw={false}><img src={`/img/demo/thumb-${d.k}.webp`} alt={`${d.brand}: ${d.sector}`} width="1200" height="800" loading="lazy" decoding="async" /></Sel>
          <span class="dm__n">{d.n}</span>
          <span class="kick">{d.sector}</span>
          <span class="h3">{d.brand}</span>
          <span class="dm__d">{d.d}</span>
          <span class="dm__tags">{d.tags.map((x) => <span>{x}</span>)}</span>
          <span class="link">{es ? 'Abrir la demo' : 'Open the demo'} <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .phero .lead{margin-top:24px}
  .dm{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(32px,4vw,64px) var(--gap)}
  .dm__c{display:grid;gap:8px;text-decoration:none;color:inherit;position:relative}
  .dm__c :global(.dm__fig){margin:12px 12px 16px}
  .dm__c img{width:100%;aspect-ratio:3/2;object-fit:cover;object-position:top;background:var(--hormigon);transition:transform 600ms var(--ease)}
  .dm__c:hover img{transform:scale(1.015)}
  .dm__n{position:absolute;left:24px;top:24px;background:var(--papel);padding:4px 10px;font-family:var(--wide);font-size:14px;z-index:1}
  .dm__c .kick{margin:0}
  .dm__d{color:#3a3a38;max-width:56ch}
  .dm__tags{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 8px}
  .dm__tags span{font-size:13px;border:1px solid var(--filete);padding:4px 9px}
  .dm__c .link{justify-self:start}
  @media (max-width:860px){.dm{grid-template-columns:1fr}}
</style>
