import Proyectos from "../components/site/Proyectos.astro";
import Proceso from "../components/site/Proceso.astro";
import PorQue from "../components/site/PorQue.astro";
import FAQ from "../components/site/FAQ.astro";
---

<Layout
	title="Diseño web en Alicante en una semana | ABG Frame"
