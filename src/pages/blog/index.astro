---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Pic from '../../components/Pic.astro';
import { ui } from '../../i18n';
const posts = (await getCollection('blog')).sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());
const t = ui.es;
const crumbs = [{ name: t.breadcrumbHome, href: '/' }, { name: 'Blog', href: '/blog/' }];
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const blogLd = { '@type': 'Blog', name: 'Blog de ABGFRAME', url: 'https://abgframe.com/blog/', inLanguage: 'es-ES', publisher: { '@id': 'https://abgframe.com/#org' }, blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `https://abgframe.com/blog/${p.slug}/` })) };
---
<Base lang="es" route="blog" breadcrumbs={crumbs} schema={[blogLd]} title="Blog: webs para arquitectura e inmobiliaria | ABGFRAME"
  description="Artículos prácticos para promotoras, estudios, constructoras e inmobiliarias: cómo vender, conseguir encargos y captar clientes desde la web.">
  <Crumbs items={crumbs} />
  <section class="phero"><div class="wrap"><h1 class="h1">Blog</h1><p class="lead">Lo que vemos funcionar en las webs del sector, explicado sin tecnicismos. Un artículo por cada forma de vender.</p></div></section>
  <section class="sec--tight" style="padding-top:0">
    <div class="wrap">
      <ul class="bl">
        {posts.map((p, i) => (
          <li>
            <a href={`/blog/${p.slug}/`} class="bl__it">
              <span class="bl__img"><Pic src={p.data.image} w={p.data.imageW} h={p.data.imageH} widths={[640, 960, 1280]} alt={p.data.imageAlt} eager={i === 0} sizes="(max-width: 860px) 100vw, 30vw" /></span>
              <span class="bl__txt">
                <span class="kick">{t.lines[p.data.line][0]} · {fmt(p.data.updatedDate ?? p.data.pubDate)} · {p.data.readingTime} min</span>
                <span class="h3">{p.data.title}</span>
                <span class="bl__d">{p.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .phero .lead{margin-top:24px}
  .bl{border-top:1px solid var(--tinta)}
  .bl li{border-bottom:1px solid var(--filete)}
  .bl__it{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--gap);padding:28px 0;text-decoration:none;align-items:center}
  .bl__img{grid-column:1/4;aspect-ratio:4/3;overflow:hidden;background:var(--hormigon)}
  .bl__img :global(img){width:100%;height:100%;object-fit:cover;transition:transform 900ms var(--ease)}
  .bl__it:hover .bl__img :global(img){transform:scale(1.03)}
  .bl__txt{grid-column:5/12;display:grid;gap:8px}
  .bl__txt .kick{margin:0}
  .bl__d{color:#3a3a38;max-width:62ch}
  .bl__it:hover .h3{color:var(--acero)}
  @media (max-width:700px){.bl__img,.bl__txt{grid-column:1/-1}}
</style>
