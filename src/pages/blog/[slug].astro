---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Pic from '../../components/Pic.astro';
import Sel from '../../components/Sel.astro';
import { r, ui } from '../../i18n';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await post.render();
const d = post.data;
const t = ui.es;
const fmt = (x: Date) => x.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `https://abgframe.com/blog/${post.slug}/`;
const crumbs = [{ name: t.breadcrumbHome, href: '/' }, { name: 'Blog', href: '/blog/' }, { name: d.title, href: `/blog/${post.slug}/` }];
const ld = {
  '@type': 'BlogPosting', headline: d.title, description: d.description, url, mainEntityOfPage: url, inLanguage: 'es-ES',
  image: `https://abgframe.com${d.image}-1280.webp`,
  datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', '@id': 'https://abgframe.com/#alvaro', name: d.author, url: 'https://abgframe.com/estudio/' },
  publisher: { '@id': 'https://abgframe.com/#org' },
};
const others = (await getCollection('blog')).filter((p) => p.slug !== post.slug).slice(0, 3);
const kicker = `${t.lines[d.line][0]} · ${d.updatedDate ? `Actualizado el ${fmt(d.updatedDate)}` : fmt(d.pubDate)} · ${d.readingTime} min de lectura`;
---
<Base lang="es" title={d.seoTitle ?? `${d.title} | ABGFRAME`} description={d.description} alternates={{ es: `/blog/${post.slug}/` }} breadcrumbs={crumbs} schema={[ld]} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={d.pubDate.toISOString()} />
    <meta property="article:modified_time" content={(d.updatedDate ?? d.pubDate).toISOString()} />
  </Fragment>
  <Crumbs items={crumbs} />
  <article>
    <header class="phero">
      <div class="wrap ah">
        <span class="kick">{kicker}</span>
        <h1 class="h1">{d.title}</h1>
        <p class="lead">{d.description}</p>
      </div>
    </header>
    <div class="wrap"><Sel as="figure" class="ah__img"><Pic src={d.image} w={d.imageW} h={d.imageH} alt={d.imageAlt} eager sizes="(max-width: 1440px) 92vw, 1280px" /></Sel></div>
    <div class="wrap">
      <div class="body"><Content /></div>
      <aside class="author">
        <img src="/img/alvaro-bergillos-480.webp" alt="Álvaro Bergillos" width="72" height="90" loading="lazy" />
        <p><b>{d.author}</b><br />Fundador de ABGFRAME, agencia web para arquitectura, construcción e inmobiliaria en Alicante. <a href="/estudio/">Más sobre el estudio</a>.</p>
      </aside>
    </div>
  </article>
  <section class="sec--tight sec--con" style="margin-top:clamp(64px,8vw,120px)">
    <div class="wrap">
      <div class="more">
        <div><span class="kick">¿Te encaja?</span><p class="h3">Hacemos webs para {t.lines[d.line][0].toLowerCase()}.</p></div>
        <a class="btn" href={r(d.line, 'es')}>Ver cómo lo hacemos <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <h2 class="kick" style="margin-top:64px">Más artículos</h2>
      <div class="cards three">{others.map((o) => <a class="card" href={`/blog/${o.slug}/`}><span class="h3">{o.data.title}</span><p class="note" style="margin-top:8px">{o.data.readingTime} min</p></a>)}</div>
    </div>
  </section>
</Base>
<style>
  .ah{max-width:1000px;margin-inline:0}
  .ah .lead{margin-top:24px}
  .ah__img{margin:12px}
  .ah__img>:global(img){aspect-ratio:16/8;width:100%;object-fit:cover}
  .body{max-width:700px;margin:clamp(56px,7vw,96px) auto 0;font-size:18px;line-height:1.7}
  .body :global(h2){font-family:var(--wide);font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-.02em;margin:56px 0 16px}
  .body :global(h3){font-weight:500;font-size:20px;margin:32px 0 10px}
  .body :global(p){margin:0 0 18px}
  .body :global(ul){list-style:none;padding:0;margin:0 0 22px;border-top:1px solid var(--filete)}
  .body :global(li){position:relative;padding:10px 0 10px 22px;border-bottom:1px solid var(--filete)}
  .body :global(li)::before{content:"";position:absolute;left:2px;top:21px;width:7px;height:7px;background:var(--acero)}
  .body :global(a){color:var(--acero)}
  .body :global(code){font-size:.88em;background:var(--hormigon);padding:1px 5px}
  .body :global(strong){font-weight:500}
  .author{max-width:700px;margin:56px auto 0;display:flex;gap:18px;align-items:center;border-top:1px solid var(--tinta);padding-top:24px;font-size:15px;color:#3a3a38}
  .author img{width:72px;height:90px;object-fit:cover;flex:none}
  .author b{font-weight:500;color:var(--tinta)}
  .more{display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:end}
  .more .kick{margin-bottom:8px}
  .three{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:16px}
  @media (max-width:860px){.three{grid-template-columns:1fr}}
</style>
