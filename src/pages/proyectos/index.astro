---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Cabecera from '../../components/site/Cabecera.astro';
import Proyectos from '../../components/site/Proyectos.astro';
---

<Layout
  title="Ejemplos de web para despachos profesionales | ABG Frame"
  description="Cuatro webs de demostración hechas por ABG Frame para gestorías, despachos de abogados y administradores de fincas. Ábrelas y pruébalas en tu móvil."
>
  <Navbar client:load />

  <main>
    <Cabecera
      eyebrow="Ejemplos"
      lead="Cuatro webs de demostración para gestorías, abogados y administradores de fincas. Los despachos son inventados; las webs funcionan de verdad."
    >
      Así quedaría <em>la web de tu despacho.</em>
    </Cabecera>
    <Proyectos conCabecera={false} />
  </main>
</Layout>
