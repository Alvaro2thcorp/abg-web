      .datos dt { font-family: var(--tit); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--amb); padding-top: 0.25rem; }
      .datos dd { margin: 0; }

      .pie { background: var(--tinta); color: #9FB2AF; padding: 1.75rem 0; font-size: 0.86rem; }
      .pie__in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; }
