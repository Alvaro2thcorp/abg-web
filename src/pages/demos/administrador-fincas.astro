      .inc__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
      .inc__izq { position: sticky; top: 100px; }
      .panel { background: var(--blanco); border: 1px solid var(--linea); border-radius: 22px; padding: 1.6rem 1.6rem 1.25rem; box-shadow: 0 40px 70px -40px rgba(6, 35, 40, 0.5); margin-top: 2.5rem; max-width: 26rem; }
      .panel__top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.8rem; color: var(--tinta-3); }
      .panel__top b { font-family: var(--tit); font-weight: 600; font-size: 0.7rem; color: #7A4B00; background: #FCE9C8; border-radius: 99px; padding: 0.2rem 0.7rem; }
      .panel__t { font-family: var(--tit); font-stretch: 110%; font-weight: 600; font-size: 1.2rem; letter-spacing: -0.02em; margin: 0.7rem 0 1.25rem; }
      .pasos { list-style: none; margin: 0; padding: 0; }
      .pasos li { position: relative; display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 0 0.75rem 1.9rem; font-size: 0.92rem; color: var(--tinta-3); }
      .pasos li::before { content: ""; position: absolute; left: 0.25rem; top: 1.12rem; width: 11px; height: 11px; border-radius: 50%; border: 2px solid var(--linea); background: var(--blanco); z-index: 1; transition: background 0.4s, border-color 0.4s, box-shadow 0.4s; }
      .pasos li:not(:last-child)::after { content: ""; position: absolute; left: calc(0.25rem + 5px); top: 1.5rem; bottom: -1.1rem; width: 1.5px; background: var(--linea); transition: background 0.4s; }
      .pasos b { font-weight: 500; color: var(--tinta-3); transition: color 0.4s; }
      .pasos .hecho b, .pasos .ahora b { color: var(--tinta); }
      .pasos .hecho::before { background: var(--ok); border-color: var(--ok); }
      .pasos .hecho::after { background: var(--ok) !important; }
      .pasos .ahora::before { border-color: var(--amb-2); background: var(--amb); box-shadow: 0 0 0 5px #FCE9C8; }
      .pasos .ahora span { color: #7A4B00; font-weight: 500; }
      .inc__caja { background: var(--pet); color: #EAF2F0; border-radius: 28px; padding: clamp(1.5rem, 3.4vw, 2.6rem); display: grid; gap: 1.4rem; }
      fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
      legend { font-family: var(--tit); font-stretch: 112%; font-weight: 600; font-size: 1.1rem; letter-spacing: -0.02em; padding: 0; margin-bottom: 0.9rem; }
      .tipos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.55rem; }
      .tipo { position: relative; display: block; }
      .tipo input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
      .tipo span { display: flex; align-items: center; min-height: 60px; padding: 0.6rem 0.95rem; border: 1.5px solid rgba(255, 255, 255, 0.22); border-radius: 14px; font-weight: 500; font-size: 0.93rem; line-height: 1.25; transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.3s; }
      .tipo:hover span { border-color: var(--amb); transform: translateY(-2px); }
      .tipo input:checked + span { border-color: var(--amb); background: var(--amb); color: var(--tinta); }
      .tipo input:focus-visible + span { outline: 2px solid #fff; outline-offset: 2px; }
      .inc__resp { margin: 0; padding: 0.85rem 1.1rem; border-radius: 14px; background: rgba(255, 255, 255, 0.1); font-weight: 500; font-size: 0.97rem; }
      .inc__resp--u { background: #FCE9C8; color: #6B4100; }
      .inc__campos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
      .inc__campos legend { grid-column: 1 / -1; }
      .inc__campos label { display: grid; gap: 0.35rem; font-size: 0.85rem; font-weight: 500; color: #BFD5D1; }
      .inc__tel { grid-column: 1 / -1; }
      .inc__campos input { font: inherit; font-size: 1rem; color: #fff; background: transparent; border: 0; border-bottom: 1.5px solid rgba(255, 255, 255, 0.3); border-radius: 0; padding: 0.7rem 0; width: 100%; transition: border-color 0.3s; }
      .inc__campos input::placeholder { color: rgba(255, 255, 255, 0.4); }
      .inc__campos input:focus { outline: 0; border-color: var(--amb); }
      .inc__ok { margin: 0; padding: 0.85rem 1.1rem; border-radius: 14px; background: rgba(255, 255, 255, 0.12); font-size: 0.9rem; }

      /* 6 · Galería horizontal */
      .hs { background: var(--pet); color: var(--arena); position: relative; z-index: 2; }
      .hs__pista { height: 100svh; align-items: center; gap: clamp(1.5rem, 3vw, 3rem); padding-inline: clamp(1.25rem, 4vw, 3.5rem); }
      .hs__intro { width: min(84vw, 30rem); flex: none; }
      .hs__intro h2 { color: #fff; font-size: clamp(2.6rem, 5.4vw, 5rem); }
      .hs__intro p:not(.eyebrow) { color: #B9CFCC; margin: 1.5rem 0 2rem; max-width: 30ch; }
      .hs__pista-ayuda { font-family: var(--tit); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amb); }
      .hs__pista-ayuda i { font-style: normal; display: inline-block; animation: empuja 1.4s ease-in-out infinite; }
      @keyframes empuja { 50% { transform: translateX(8px); } }
      .finca { flex: none; width: min(82vw, 44rem); display: grid; gap: 1.2rem; }
      .finca:nth-child(even) { transform: translateY(4svh); }
      .finca:nth-child(odd) { transform: translateY(-3svh); }
      .finca__img { height: 56svh; border-radius: 22px; }
      .finca__img img { width: 116%; max-width: none; margin-left: -8%; }
      .finca__txt { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.2rem 1.2rem; align-items: baseline; }
      .finca__n { grid-row: span 2; font-family: var(--tit); font-stretch: 125%; font-weight: 700; font-size: clamp(2.4rem, 4vw, 3.6rem); line-height: 0.9; color: transparent; -webkit-text-stroke: 1.5px var(--amb); }
      .finca h3 { font-size: clamp(1.3rem, 2.1vw, 1.8rem); color: #fff; }
      .finca p { margin: 0.3rem 0 0; color: #B9CFCC; font-size: 0.98rem; max-width: 44ch; }
      .hs__barra { position: absolute; left: clamp(1.25rem, 4vw, 3.5rem); right: clamp(1.25rem, 4vw, 3.5rem); bottom: 2.2rem; height: 2px; background: rgba(255, 255, 255, 0.18); }
      .hs__barra i { display: block; height: 100%; background: var(--amb); transform: scaleX(0); transform-origin: left; }

      /* 7 · Área de vecinos */
      .area { background: var(--blanco); border: 1px solid var(--linea); border-radius: 22px; overflow: hidden; box-shadow: 0 50px 90px -50px rgba(6, 35, 40, 0.45); }
      .area__barra { display: flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1rem; background: #ECEAE2; border-bottom: 1px solid var(--linea); }
      .area__barra i { width: 11px; height: 11px; border-radius: 50%; background: #CFCBBE; }
      .area__barra span { margin-left: 0.8rem; font-size: 0.78rem; color: var(--tinta-3); background: var(--blanco); border-radius: 99px; padding: 0.2rem 1rem; }
      .area__cab { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem 1.5rem; padding: 1.1rem 1.6rem; background: var(--noche); color: #DCE6E4; font-size: 0.88rem; }
      .area__cab span:last-child { color: var(--amb); font-weight: 500; }
      .area__tabs { display: flex; gap: 0.25rem; padding: 0.75rem 1rem 0; border-bottom: 1px solid var(--linea); }
      .area__tabs button { font-family: var(--tit); font-stretch: 108%; font-weight: 600; font-size: 0.93rem; color: var(--tinta-3); background: none; border: 0; border-bottom: 2.5px solid transparent; padding: 0.8rem 1.1rem; margin-bottom: -1px; cursor: pointer; transition: color 0.2s; }
      .area__tabs button:hover { color: var(--tinta); }
      .area__tabs button[aria-selected="true"] { color: var(--pet); border-color: var(--amb); }
      .area__panel { padding: 0.5rem 1.6rem 1.6rem; animation: entra 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
      @keyframes entra { from { opacity: 0; transform: translateY(12px); } }
      .lista { list-style: none; margin: 0; padding: 0; }
      .lista li { display: grid; grid-template-columns: 6.2rem minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: 1.1rem 0; border-bottom: 1px solid #E8E8E1; }
      .lista li:last-child { border-bottom: 0; }
      .lista b { font-weight: 500; }
      .lista time { font-size: 0.86rem; color: var(--tinta-3); white-space: nowrap; }
      .est { justify-self: start; font-family: var(--tit); font-weight: 600; font-size: 0.7rem; border-radius: 99px; padding: 0.22rem 0.7rem; background: #FCE9C8; color: #7A4B00; }
      .est--ok { background: #DDF0E6; color: #14553A; }
      .est--pdf { background: #E3EFEC; color: var(--pet-2); }
      .cuentas { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 1rem 0 0; }
      .cuentas div { background: var(--hueso); border-radius: 14px; padding: 1.2rem 1.3rem; }
      .cuentas dt { font-size: 0.82rem; color: var(--tinta-3); }
      .cuentas dd { margin: 0.35rem 0 0; font-family: var(--tit); font-stretch: 112%; font-weight: 600; font-size: 1.5rem; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
      .area__nota { margin: 1rem 0 0; font-size: 0.8rem; color: var(--tinta-3); }

      /* 8 · Calculadora */
      .calc__caja { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); border-radius: 28px; overflow: hidden; background: var(--blanco); box-shadow: 0 50px 90px -55px rgba(6, 35, 40, 0.5); }
      .calc__campos { padding: clamp(1.6rem, 3.5vw, 3rem); display: grid; gap: 0.7rem; align-content: start; }
      .calc__campos > label { display: flex; justify-content: space-between; align-items: baseline; font-weight: 500; margin-top: 0.8rem; }
      .calc__campos output { font-family: var(--tit); font-stretch: 118%; font-weight: 700; font-size: 1.7rem; letter-spacing: -0.03em; color: var(--pet); font-variant-numeric: tabular-nums; }
      input[type="range"] { --p: 20%; -webkit-appearance: none; appearance: none; width: 100%; height: 30px; background: transparent; cursor: pointer; }
      input[type="range"]::-webkit-slider-runnable-track { height: 6px; border-radius: 99px; background: linear-gradient(90deg, var(--pet) var(--p), var(--arena-2) var(--p)); }
      input[type="range"]::-moz-range-track { height: 6px; border-radius: 99px; background: linear-gradient(90deg, var(--pet) var(--p), var(--arena-2) var(--p)); }
      input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; margin-top: -10px; border-radius: 50%; background: var(--amb); border: 4px solid var(--blanco); box-shadow: 0 4px 12px rgba(6, 35, 40, 0.35); transition: transform 0.2s; }
      input[type="range"]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--amb); border: 4px solid var(--blanco); box-shadow: 0 4px 12px rgba(6, 35, 40, 0.35); }
      input[type="range"]:active::-webkit-slider-thumb { transform: scale(1.2); }
      .calc__checks { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin-top: 1.2rem; }
      .calc__checks label { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.97rem; min-height: 34px; cursor: pointer; }
      .calc__checks input { width: 20px; height: 20px; accent-color: var(--pet); }
      .calc__res { background: var(--noche); color: #EAF2F0; padding: clamp(1.6rem, 3.5vw, 3rem); display: grid; align-content: center; gap: 0.4rem; }
      .calc__et { font-family: var(--tit); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amb); margin: 0; }
      .calc__num { font-family: var(--tit); font-stretch: 122%; font-weight: 700; font-size: clamp(3.2rem, 6.4vw, 5.6rem); letter-spacing: -0.06em; line-height: 1; margin: 0.4rem 0 0; font-variant-numeric: tabular-nums; }
      .calc__num small { font-size: 1.1rem; font-weight: 400; letter-spacing: 0; font-stretch: 100%; color: #A9BDBA; margin-left: 0.2rem; }
      .calc__viv { margin: 0 0 1.6rem; font-size: 0.95rem; color: #BFD5D1; }
      .calc__viv b { color: #fff; font-weight: 600; }

      /* 9 · Contacto */
      .fin { position: relative; z-index: 2; color: #fff; overflow: hidden; background: var(--noche); }
      .fin__img { position: absolute; inset: -12% 0; }
      .fin__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .fin__img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(6, 35, 40, 0.9) 0%, rgba(6, 35, 40, 0.72) 50%, rgba(6, 35, 40, 0.95) 100%); }
      .fin__in { position: relative; padding-block: clamp(6rem, 13vw, 12rem) clamp(4rem, 8vw, 7rem); }
      .fin__h { font-size: clamp(2.6rem, 7.6vw, 7.6rem); font-stretch: 122%; line-height: 0.92; letter-spacing: -0.05em; max-width: 14ch; }
      .fin__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); margin-top: clamp(3rem, 6vw, 5rem); align-items: start; }
      .fin__p { margin: 0; color: #C7DAD7; font-size: 1.12rem; max-width: 36ch; }
      .datos { margin: 0; border-top: 1px solid rgba(255, 255, 255, 0.25); }
      .datos div { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.25); }
      .datos dt { font-family: var(--tit); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amb); padding-top: 0.3rem; }
      .datos dd { margin: 0; }

      .pie { position: relative; z-index: 2; background: var(--noche); color: #9FB2AF; font-size: 0.86rem; overflow: hidden; }
      .pie__marca { padding: 1rem 0 0; }
      .pie__marca span { font-family: var(--tit); font-stretch: 125%; font-weight: 700; font-size: clamp(4rem, 15vw, 14rem); line-height: 0.9; letter-spacing: -0.06em; text-transform: uppercase; color: transparent; -webkit-text-stroke: 1.5px rgba(239, 234, 224, 0.28); padding-right: 0.35em; }
      .pie__in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; padding-block: 1.75rem; }
      .pie p { margin: 0; }
      .pie b { color: #fff; font-weight: 500; }
      .pie a { color: #fff; }

      @media (max-width: 1100px) {
        .nav { display: none; }
        .hero__lado { flex-direction: column; align-items: flex-start; }
        .hero__img { --t: 60%; }
      }
      @media (max-width: 899px) {
        .mani__grid, .inc__grid, .fin__grid, .calc__caja { grid-template-columns: minmax(0, 1fr); }
        .mani__fotos { max-width: 26rem; }
        .inc__izq { position: static; }
        .edi__grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
        .edi__txt { display: contents; }
        .edi__cab { order: -1; min-height: 0; padding: 4.5rem 0 1rem; }
        .edi__vis { height: 50svh; padding: 0.75rem 0 2.6rem; z-index: 3; background: var(--noche); box-shadow: 0 18px 24px -6px var(--noche); }
        .edi__pasos { padding-bottom: 12svh; }
        .paso { min-height: 44svh; }
        .cuentas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .hs__pista { height: auto; padding-block: 4.5rem 5rem; align-items: start; }
        .finca:nth-child(n) { transform: none; }
        .finca__img { height: 46svh; }
        .finca__img img { width: 100%; margin-left: 0; }
        .hs__barra { display: none; }
        .cifras { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem 1rem; }
      }
      @media (max-width: 640px) {
        body { font-size: 16.5px; }
        .cab { height: 64px; margin-bottom: -64px; }
        .urg span { display: none; }
        .hero__txt { padding-top: 84px; }
        .hero h1 { font-size: min(11.4vw, 9svh); font-stretch: 112%; }
        .hero__lado p { font-size: 0.95rem; }
        .hero__cta { width: 100%; }
        .hero__cta .btn { flex: 1 1 100%; }
        .hero__img { --t: 66%; --b: 4%; --x: 4%; }
        .hero__baja { display: none; }
        .hero__lema br { display: none; }
        .hs { scroll-padding-inline: 1.25rem; }
        .tipos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .inc__campos { grid-template-columns: minmax(0, 1fr); }
        .lista li { grid-template-columns: minmax(0, 1fr) auto; }
        .lista .est { grid-column: 1 / -1; }
        .area__tabs { padding-inline: 0.4rem; }
        .area__tabs button { padding-inline: 0.7rem; }
        .area__panel { padding-inline: 1.1rem; }
        .area__barra span { display: none; }
        .datos div { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>
