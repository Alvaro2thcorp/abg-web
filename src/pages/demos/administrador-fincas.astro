        .servs { grid-template-columns: minmax(0, 1fr); }
        .lista li { grid-template-columns: minmax(0, 1fr) auto; }
        .lista .est { grid-column: 1 / -1; }
        .area__tabs { padding-inline: 0.5rem; }
