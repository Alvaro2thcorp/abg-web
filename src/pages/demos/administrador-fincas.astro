        .servs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .cuentas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .calc__caja { grid-template-columns: minmax(0, 1fr); }
      }
      @media (max-width: 640px) {
        .cifras { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .tipos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
