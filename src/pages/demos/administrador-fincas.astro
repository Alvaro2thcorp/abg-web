---
import DemoBar from "../../components/demos/DemoBar.astro";
import DemoHead from "../../components/demos/DemoHead.astro";
import Foto from "../../components/demos/Foto.astro";

const tipos = [
  { id: "ascensor", t: "Ascensor", r: "Aviso al mantenedor en 15 minutos", u: true },
  { id: "agua", t: "Fuga de agua", r: "Fontanero de guardia en menos de 2 horas", u: true },
  { id: "luz", t: "Luz del portal o escalera", r: "Electricista en 24 horas", u: false },
  { id: "garaje", t: "Puerta del garaje", r: "Técnico en el mismo día", u: false },
  { id: "limpieza", t: "Limpieza", r: "Se traslada a la empresa en el día", u: false },
  { id: "otro", t: "Otra cosa", r: "Le contestamos en 24 horas", u: false },
];

const servicios = [
  { t: "Cuentas claras", d: "Presupuesto anual, liquidación trimestral y el saldo de la comunidad a la vista de todos los vecinos.", e: "Saldo en cuenta · 18.420 €" },
  { t: "Juntas que duran lo justo", d: "Convocatoria, orden del día y acta enviada en 7 días. Voto delegado y asistencia por videollamada.", e: "Junta · 11 dic · 19:30" },
  { t: "Morosidad", d: "Reclamación amistosa, certificado de deuda y proceso monitorio. Sin esperar a que la deuda crezca.", e: "2 recibos pendientes de 48" },
  { t: "Mantenimiento y obras", d: "Tres presupuestos comparados para cada obra y seguimiento hasta que se cierra.", e: "Fachada · 3 presupuestos" },
  { t: "Seguros y siniestros", d: "Damos el parte, perseguimos al perito y le avisamos cuando la aseguradora paga.", e: "Parte 2026-031 · en peritación" },
  { t: "ITE, ascensores y normativa", d: "Inspecciones al día y un calendario para que nada caduque sin avisar.", e: "ITE favorable · hasta 2031" },
];

const fincas = [
  { img: "fincas/clasico", w: 1200, h: 1800, t: "Edificios del centro", d: "Fincas con historia: fachadas, ITE al día y ascensores que hay que encajar donde no los había." },
  { img: "fincas/residencial", w: 1500, h: 843, t: "Urbanizaciones", d: "Varios portales, jardines y conserje. Un presupuesto por fase y las cuentas separadas." },
  { img: "fincas/piscina", w: 1500, h: 1000, t: "Comunidades con piscina", d: "Socorrista, análisis del agua y apertura de temporada, contratados antes de junio." },
  { img: "fincas/curva", w: 1500, h: 1012, t: "Residenciales de playa", d: "Propietarios que viven fuera: juntas por videollamada, actas traducidas y avisos por correo." },
  { img: "fincas/ladrillo", w: 1500, h: 1000, t: "Bloques de barrio", d: "Muchas viviendas y cuotas ajustadas. La morosidad se vigila mes a mes, no una vez al año." },
  { img: "fincas/portal", w: 1500, h: 1125, t: "Garajes y locales", d: "Portales, trasteros y plazas con su propio reparto de gastos, sin mezclarlo con las viviendas." },
];

const actas = [
  { f: "12 jun 2026", t: "Junta general ordinaria", p: "6 páginas" },
  { f: "3 feb 2026", t: "Junta extraordinaria · Fachada", p: "4 páginas" },
  { f: "14 jun 2025", t: "Junta general ordinaria", p: "7 páginas" },
];
const cuentas = [
  { c: "Saldo en cuenta", v: "18.420 €" },
  { c: "Fondo de reserva", v: "9.150 €" },
  { c: "Recibos pendientes", v: "2 de 48" },
  { c: "Gasto del trimestre", v: "7.863 €" },
];
const avisos = [
  { e: "Resuelta", t: "Puerta del garaje no cierra", f: "28 sep", ok: true },
  { e: "En curso", t: "Gotera en el rellano del 4.º", f: "2 oct", ok: false },
  { e: "Resuelta", t: "Bombilla fundida en el portal", f: "19 sep", ok: true },
];

// Edificio dibujado: 6 plantas, 4 ventanas por planta
const plantas = [0, 1, 2, 3, 4, 5];
const cols = [132, 188, 292, 348];
const morosas = ["1-3", "4-0"]; // planta-columna
const junta = ["0-1", "1-0", "1-2", "2-3", "3-1", "4-2", "5-0", "5-3"];
const palabras = ["Averías", "Actas", "Cuentas", "Juntas", "Morosidad", "Seguros", "Ascensores", "Obras"];
---
<!doctype html>
<html lang="es">
  <head>
    <DemoHead
      titulo="Postiguet Fincas · Demostración de ABG Frame"
      descripcion="Web de demostración de una administración de fincas, hecha por ABG Frame."
      fuentes="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=Figtree:wght@400;500;600&display=swap"
      precarga="/images/demos/fincas/hero.webp"
    />
  </head>
  <body>
    <div class="telon" aria-hidden="true"><span>Postiguet <b>Fincas</b></span></div>
    <i data-progreso aria-hidden="true"></i>
    <DemoBar />

    <header class="cab" data-cab>
      <div class="w cab__in">
        <a class="marca" href="#inicio" aria-label="Postiguet Fincas, inicio">
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><rect x="3" y="12" width="11" height="17" fill="none" stroke="currentColor" stroke-width="2" /><rect x="14" y="3" width="15" height="26" fill="none" stroke="currentColor" stroke-width="2" /><path d="M19 9h5M19 15h5M19 21h5M7 18h3M7 23h3" stroke="currentColor" stroke-width="2" /></svg>
          <span>Postiguet <b>Fincas</b></span>
        </a>
        <nav class="nav" aria-label="Secciones">
          <a href="#servicios">Servicios</a>
          <a href="#incidencia">Avisar de una incidencia</a>
          <a href="#vecinos">Área de vecinos</a>
          <a href="#presupuesto">Presupuesto</a>
        </nav>
        <a class="urg" href="#contacto" data-magnetic="0.25"><span>Urgencias 24 h</span>600 00 00 00</a>
      </div>
    </header>

    <main>
      <!-- 1 · Portada: la foto se abre hasta ocupar toda la pantalla -->
      <section class="hero" id="inicio">
        <div class="w hero__txt">
          <div class="hero__tit">
            <p class="chip" data-reveal data-delay="1">Administradores de fincas colegiados · Alicante</p>
            <h1 data-split="lines" data-delay="0.55">Su comunidad,<br />al día.</h1>
          </div>
          <div class="hero__lado" data-reveal data-delay="1.15">
            <p class="hero__sub">
              Los vecinos avisan de una avería desde el móvil y ven cómo va. El presidente tiene las cuentas
              y las actas a un clic. Nosotros nos ocupamos de lo demás.
            </p>
            <div class="hero__cta">
              <a class="btn btn--pet" href="#incidencia" data-magnetic="0.2">Avisar de una incidencia</a>
              <a class="btn btn--linea" href="#presupuesto" data-magnetic="0.2">Presupuesto para mi comunidad</a>
            </div>
          </div>
        </div>

        <div class="hero__img">
          <Foto src="fincas/hero" ancho={2000} alto={1350} prioridad sizes="100vw" alt="Edificio blanco de viviendas con escalera exterior bajo un cielo despejado" />
          <i class="hero__velo" aria-hidden="true"></i>
        </div>

        <div class="hero__sobre">
          <div class="w">
            <p class="hero__lema">Desde 1998, la finca en orden<br />y los vecinos informados.</p>
            <dl class="cifras">
              <div><dt><span data-n="86">86</span></dt><dd>comunidades administradas</dd></div>
              <div><dt><span data-n="2940">2.940</span></dt><dd>viviendas</dd></div>
              <div><dt><span data-n="4">4</span> h</dt><dd>tiempo medio de primera respuesta</dd></div>
              <div><dt><span data-n="28">28</span></dt><dd>años con el despacho abierto</dd></div>
            </dl>
          </div>
        </div>
        <p class="hero__baja" aria-hidden="true"><i></i>Baje</p>
      </section>

      <!-- 2 · Cinta -->
      <div class="cinta" aria-hidden="true" data-marquee data-vel="70">
        <div>{palabras.map((p) => <span>{p}<i>✳</i></span>)}</div>
      </div>

      <!-- 3 · Manifiesto -->
      <section class="mani">
        <div class="w mani__grid">
          <div class="mani__txt">
            <p class="eyebrow" data-reveal>Cómo trabajamos</p>
            <p class="mani__p" data-words>
              Administramos 86 comunidades de Alicante con una regla sencilla: que ningún vecino tenga que
              llamar tres veces para saber cómo va lo suyo. Lo que entra queda registrado, tiene un responsable
              y se puede seguir desde el móvil.
            </p>
          </div>
          <div class="mani__fotos" aria-hidden="true">
            <div class="marco mani__f1" data-reveal="clip"><Foto src="fincas/terrazas" ancho={1200} alto={1800} sizes="(max-width: 900px) 60vw, 28vw" data-parallax="8" /></div>
            <div class="marco mani__f2" data-reveal="clip" data-delay="0.15"><Foto src="fincas/palmera" ancho={1100} alto={1650} sizes="(max-width: 900px) 40vw, 18vw" data-parallax="-10" /></div>
          </div>
        </div>
      </section>

      <!-- 4 · El edificio que se enciende con cada servicio -->
      <section id="servicios" class="edi" data-paso="0">
        <div class="w edi__grid">
          <div class="edi__vis">
            <div class="edi__caja">
              <svg class="edificio" viewBox="0 0 520 640" role="img" aria-label="Dibujo de un edificio de viviendas que cambia según el servicio">
                <g class="estrellas">
                  {[[40, 60], [90, 130], [460, 50], [490, 150], [30, 220], [455, 250], [70, 330], [480, 360], [250, 30], [170, 55], [360, 40]].map(([x, y], i) => <circle cx={x} cy={y} r={i % 3 === 0 ? 1.8 : 1.1} style={`--i:${i}`} />)}
                </g>
                <circle class="luna" cx="430" cy="92" r="26" />
                <!-- azotea -->
                <path class="tr" d="M150 80V52h90v28M150 52l90 28M240 52l-90 28M330 80V40M330 40l-16 12M330 40l16 12M322 58h16" />
                <!-- cuerpo -->
                <rect class="tr cuerpo" x="110" y="80" width="300" height="480" />
                <path class="tr tenue" d={plantas.map((p) => `M110 ${146 + p * 66}H410`).join("")} />
                <!-- hueco del ascensor -->
                <rect class="tr hueco" x="244" y="80" width="32" height="480" />
                <rect class="cabina" x="248" y="512" width="24" height="44" rx="2" />
                <!-- ventanas -->
                {plantas.map((p) => cols.map((x, c) => {
                  const k = `${p}-${c}`;
                  return <rect class:list={["v", { "v--mor": morosas.includes(k), "v--junta": junta.includes(k), "v--agua": k === "2-2" }]} x={x} y={94 + p * 66} width="40" height="38" rx="2" style={`--i:${p * 4 + c}`} />;
                }))}
                {plantas.map((p) => cols.map((x) => <path class="tr tenue" d={`M${x - 4} ${138 + p * 66}h48`} />))}
                <!-- planta baja -->
                <rect class="v v--local" x="128" y="490" width="96" height="52" rx="2" />
                <rect class="tr portal" x="244" y="496" width="32" height="64" />
                <rect class="tr" x="300" y="500" width="92" height="60" />
                <path class="tr tenue" d="M300 515h92M300 530h92M300 545h92" />
                <path class="tr" d="M60 560h400" />
                <!-- obras: andamio y grúa -->
                <g class="andamio">
                  <path pathLength="1" d="M96 560V150M124 560V150M96 216h28M96 282h28M96 348h28M96 414h28M96 480h28M96 150h28M96 216l28 66M124 282l-28 66M96 348l28 66M124 414l-28 66" />
                  <path pathLength="1" d="M70 150V70h150M70 70l40 0M70 90L92 70M196 70v40" />
                </g>
                <!-- seguro: gota y escudo -->
                <path class="gota" d="M312 300c6 9 10 14 10 20a10 10 0 0 1-20 0c0-6 4-11 10-20z" />
                <path class="escudo" pathLength="1" d="M260 18c60 22 130 28 190 30 0 210-40 480-190 574C110 528 70 258 70 48c60-2 130-8 190-30z" />
                <!-- ITE: sello -->
                <g class="sello" transform="translate(430 470)">
                  <circle r="34" /><path d="M-14 0l10 10 18-22" />
                </g>
              </svg>
              <div class="edi__etqs" aria-hidden="true">
                {servicios.map((s, i) => <p class="edi__etq" data-e={i + 1}>{s.e}</p>)}
              </div>
            </div>
          </div>

          <div class="edi__txt">
            <header class="edi__cab">
              <p class="eyebrow eyebrow--amb" data-reveal>Servicios</p>
              <h2 data-split="lines">Lo que hacemos por su comunidad.</h2>
              <p class="edi__sub" data-reveal>Baje y mire el edificio: cada servicio enciende una parte.</p>
            </header>
            <ol class="edi__pasos">
              {servicios.map((s, i) => (
                <li class="paso" data-i={i + 1}>
                  <span class="paso__n">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- 5 · Incidencias -->
      <section id="incidencia" class="sec inc">
        <div class="w inc__grid">
          <div class="inc__izq">
            <p class="eyebrow" data-reveal>Para vecinos</p>
            <h2 data-split="lines">¿Algo no funciona? Avísenos aquí.</h2>
            <p class="lead" data-reveal>Elija qué pasa y le decimos cuánto tardamos. Queda registrado con número y puede seguirlo sin llamar.</p>

            <div class="panel" aria-label="Ejemplo de seguimiento de una incidencia" data-reveal>
              <div class="panel__top"><span>Incidencia 2026-0147</span><b>En curso</b></div>
              <p class="panel__t">Gotera en el rellano del 4.º</p>
              <ol class="pasos">
                <li class="hecho"><b>Recibida</b><span>Jueves, 9:12</span></li>
                <li class="hecho"><b>Fontanero avisado</b><span>Jueves, 9:40</span></li>
                <li class="ahora"><b>Visita programada</b><span>Hoy, 16:00–18:00</span></li>
                <li><b>Resuelta</b><span>Pendiente</span></li>
              </ol>
            </div>
          </div>

          <form class="inc__caja" id="form-inc" novalidate data-reveal data-delay="0.1">
            <fieldset>
              <legend>1. ¿Qué ocurre?</legend>
              <div class="tipos">
                {tipos.map((t, i) => (
                  <label class="tipo">
                    <input type="radio" name="tipo" value={t.id} data-r={t.r} data-u={t.u ? "1" : "0"} checked={i === 1} />
                    <span>{t.t}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <p class="inc__resp" id="inc-resp" aria-live="polite"></p>
            <fieldset class="inc__campos">
              <legend>2. ¿Dónde?</legend>
              <label>Comunidad<input type="text" name="comunidad" autocomplete="off" placeholder="Calle y número" /></label>
              <label>Portal, piso o zona<input type="text" name="zona" autocomplete="off" placeholder="Ej.: rellano del 4.º" /></label>
              <label class="inc__tel">Su teléfono<input type="tel" name="telefono" autocomplete="off" placeholder="Para avisarle" /></label>
            </fieldset>
            <button class="btn btn--amb btn--ancho" type="submit">Registrar incidencia</button>
            <p class="inc__ok" id="inc-ok" hidden></p>
          </form>
        </div>
      </section>

      <!-- 6 · Tipos de finca: galería horizontal -->
      <section class="hs" data-hscroll aria-label="Tipos de comunidad que administramos">
        <div class="hs__pista">
          <div class="hs__intro">
            <p class="eyebrow eyebrow--amb">Qué administramos</p>
            <h2>Cada finca<br />es distinta.</h2>
            <p>De un portal de seis vecinos a una urbanización con piscina y conserje.</p>
            <span class="hs__pista-ayuda">Siga bajando <i>→</i></span>
          </div>
          {fincas.map((f, i) => (
            <article class="finca">
              <div class="marco finca__img"><Foto src={f.img} ancho={f.w} alto={f.h} sizes="(max-width: 900px) 82vw, 46vw" data-hpar="7" alt="" /></div>
              <div class="finca__txt">
                <span class="finca__n">{String(i + 1).padStart(2, "0")}</span>
                <h3>{f.t}</h3>
                <p>{f.d}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="hs__barra" aria-hidden="true"><i></i></div>
      </section>

      <!-- 7 · Área de vecinos -->
      <section id="vecinos" class="sec">
        <div class="w">
          <header class="cabsec">
            <p class="eyebrow" data-reveal>Área de vecinos</p>
            <h2 data-split="lines">Así ve un vecino su comunidad.</h2>
            <p class="lead" data-reveal>Cada propietario entra con su clave y encuentra lo que antes pedía por teléfono. Pruebe las pestañas.</p>
          </header>

          <div class="area" data-reveal>
            <div class="area__barra" aria-hidden="true"><i></i><i></i><i></i><span>vecinos.postiguetfincas.example</span></div>
            <div class="area__cab">
              <span>Comunidad de ejemplo · Calle de Ejemplo, 8</span>
              <span>Próxima junta: 11 de diciembre, 19:30</span>
            </div>
            <div class="area__tabs" role="tablist" aria-label="Área de vecinos">
              <button role="tab" id="t-avisos" aria-controls="p-avisos" aria-selected="true">Incidencias</button>
              <button role="tab" id="t-actas" aria-controls="p-actas" aria-selected="false" tabindex="-1">Actas</button>
              <button role="tab" id="t-cuentas" aria-controls="p-cuentas" aria-selected="false" tabindex="-1">Cuentas</button>
            </div>

            <div role="tabpanel" id="p-avisos" aria-labelledby="t-avisos" class="area__panel">
              <ul class="lista">
                {avisos.map((a) => (
                  <li><span class:list={["est", { "est--ok": a.ok }]}>{a.e}</span><b>{a.t}</b><time>{a.f}</time></li>
                ))}
              </ul>
            </div>
            <div role="tabpanel" id="p-actas" aria-labelledby="t-actas" class="area__panel" hidden>
              <ul class="lista">
                {actas.map((a) => (
                  <li><span class="est est--pdf">PDF</span><b>{a.t}</b><time>{a.f} · {a.p}</time></li>
                ))}
              </ul>
            </div>
            <div role="tabpanel" id="p-cuentas" aria-labelledby="t-cuentas" class="area__panel" hidden>
              <dl class="cuentas">
                {cuentas.map((c) => (<div><dt>{c.c}</dt><dd>{c.v}</dd></div>))}
              </dl>
              <p class="area__nota">Datos inventados para la demostración.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 8 · Calculadora -->
      <section id="presupuesto" class="sec sec--arena">
        <div class="w">
          <header class="cabsec">
            <p class="eyebrow" data-reveal>Para presidentes y juntas</p>
            <h2 data-split="lines">¿Cuánto costaría administrar su comunidad?</h2>
            <p class="lead" data-reveal>Mueva los datos y verá una cifra orientativa al momento. El presupuesto definitivo se lo llevamos a la junta, por escrito.</p>
          </header>

          <div class="calc__caja" data-reveal>
            <div class="calc__campos">
              <label for="c-viv">Viviendas <output id="o-viv">24</output></label>
              <input id="c-viv" type="range" min="6" max="120" step="1" value="24" />
              <label for="c-gar">Plazas de garaje <output id="o-gar">12</output></label>
              <input id="c-gar" type="range" min="0" max="120" step="1" value="12" />
              <div class="calc__checks">
                <label><input id="c-asc" type="checkbox" checked /> Ascensor</label>
                <label><input id="c-pis" type="checkbox" /> Piscina o zonas comunes</label>
                <label><input id="c-con" type="checkbox" /> Conserje o empleados</label>
              </div>
            </div>
            <div class="calc__res" aria-live="polite">
              <p class="calc__et">Honorarios orientativos</p>
              <p class="calc__num"><span id="r-mes">0</span> €<small>/mes</small></p>
              <p class="calc__viv">Unos <b id="r-viv">0</b> € por vivienda al mes, sin IVA</p>
              <a class="btn btn--amb btn--ancho" href="#contacto">Pedir presupuesto en firme</a>
            </div>
          </div>
        </div>
      </section>

      <!-- 9 · Contacto -->
      <section id="contacto" class="fin">
        <div class="fin__img" aria-hidden="true"><Foto src="fincas/puerto" ancho={1800} alto={1200} sizes="100vw" data-parallax="10" /></div>
        <div class="w fin__in">
          <p class="eyebrow eyebrow--amb" data-reveal>Contacto</p>
          <h2 class="fin__h" data-split="lines">Hablamos con su junta cuando quieran.</h2>
          <div class="fin__grid">
            <p class="fin__p" data-reveal>Vamos a la reunión, explicamos cómo trabajamos y dejamos el presupuesto por escrito. Sin compromiso.</p>
            <dl class="datos" data-stagger="0.08">
              <div><dt>Oficina</dt><dd>965 00 00 00<br />Lunes a viernes, 9:00 a 14:00 y 16:30 a 19:00</dd></div>
              <div><dt>Urgencias</dt><dd>600 00 00 00<br />Todos los días, 24 horas</dd></div>
              <div><dt>Dirección</dt><dd>Calle de Ejemplo, 15, bajo<br />Alicante</dd></div>
            </dl>
          </div>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="pie__marca" aria-hidden="true" data-marquee="der" data-vel="40"><div><span>Postiguet Fincas</span><span>Postiguet Fincas</span></div></div>
      <div class="w pie__in">
        <p><b>Postiguet Fincas</b> · Calle de Ejemplo, 15 · Alicante</p>
        <p>Negocio ficticio. Web de demostración creada por <a href="/">ABG Frame</a>.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Incidencias
        var resp = document.getElementById("inc-resp");
        var radios = Array.prototype.slice.call(document.querySelectorAll('input[name="tipo"]'));
        function pinta() {
          var r = radios.filter(function (x) { return x.checked; })[0];
          if (!r) return;
          resp.textContent = (r.dataset.u === "1" ? "Urgente. " : "") + r.dataset.r + ".";
          resp.className = "inc__resp" + (r.dataset.u === "1" ? " inc__resp--u" : "");
        }
        radios.forEach(function (r) { r.addEventListener("change", pinta); });
        pinta();
        document.getElementById("form-inc").addEventListener("submit", function (e) {
          e.preventDefault();
          var ok = document.getElementById("inc-ok");
          ok.textContent = "Demostración: no se ha enviado nada. En una web real, el vecino recibiría aquí su número de incidencia (por ejemplo, 2026-0148) y un aviso en cada paso.";
          ok.hidden = false;
        });

        // Pestañas del área de vecinos
        var tabs = Array.prototype.slice.call(document.querySelectorAll(".area__tabs [role=tab]"));
        function activar(t, foco) {
          tabs.forEach(function (x) {
            var on = x === t;
            x.setAttribute("aria-selected", on ? "true" : "false");
            x.tabIndex = on ? 0 : -1;
            document.getElementById(x.getAttribute("aria-controls")).hidden = !on;
          });
          if (foco) t.focus();
        }
        tabs.forEach(function (t, i) {
          t.addEventListener("click", function () { activar(t, false); });
          t.addEventListener("keydown", function (e) {
            if (e.key === "ArrowRight") { e.preventDefault(); activar(tabs[(i + 1) % tabs.length], true); }
            if (e.key === "ArrowLeft") { e.preventDefault(); activar(tabs[(i - 1 + tabs.length) % tabs.length], true); }
          });
        });

        // Calculadora orientativa (la cifra rueda hasta el nuevo valor)
        var viv = document.getElementById("c-viv"), gar = document.getElementById("c-gar");
        var asc = document.getElementById("c-asc"), pis = document.getElementById("c-pis"), con = document.getElementById("c-con");
        var rMes = document.getElementById("r-mes"), rViv = document.getElementById("r-viv");
        var actual = 0, raf = 0;
        var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        function rueda(hasta) {
          cancelAnimationFrame(raf);
          if (quieto) { actual = hasta; rMes.textContent = hasta.toLocaleString("es-ES"); return; }
          var desde = actual, t0 = performance.now();
          (function paso(t) {
            var k = Math.min(1, (t - t0) / 450), e = 1 - Math.pow(1 - k, 3);
            actual = desde + (hasta - desde) * e;
            rMes.textContent = (Math.round(actual / 5) * 5).toLocaleString("es-ES");
            if (k < 1) raf = requestAnimationFrame(paso); else actual = hasta;
          })(t0);
        }
        function calc() {
          var v = +viv.value, g = +gar.value;
          document.getElementById("o-viv").textContent = v;
          document.getElementById("o-gar").textContent = g;
          var porViv = v <= 20 ? 7.5 : v <= 50 ? 6 : 5;
          var total = Math.max(120, v * porViv) + g * 1.2 + (asc.checked ? 15 : 0) + (pis.checked ? 35 : 0) + (con.checked ? 45 : 0);
          total = Math.round(total / 5) * 5;
          rueda(total);
          rViv.textContent = (total / v).toLocaleString("es-ES", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          [viv, gar].forEach(function (r) { r.style.setProperty("--p", ((r.value - r.min) / (r.max - r.min) * 100) + "%"); });
        }
        [viv, gar, asc, pis, con].forEach(function (el) { el.addEventListener("input", calc); });
        calc();
      })();
    </script>

    <script>
      import { iniciar, gsap, ScrollTrigger, contar } from "../../scripts/demo-motion";

      iniciar(({ ancho }) => {
        // Portada: la foto pasa de tarjeta a pantalla completa mientras se baja
        const hero = document.querySelector<HTMLElement>(".hero")!;
        const img = hero.querySelector<HTMLElement>(".hero__img")!;
        const txt = hero.querySelector<HTMLElement>(".hero__txt")!;
        // La tarjeta de la foto empieza justo debajo del texto, sea cual sea la pantalla
        const corte = () => Math.round(txt.offsetTop + txt.offsetHeight + 30) + "px";
        gsap.set(img, { "--t": corte() });
        gsap.from(img, { yPercent: 12, autoAlpha: 0, duration: 1.5, ease: "expo.out", delay: 0.75 });
        let contado = false;
        const tl = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: { trigger: hero, start: "top top", end: "+=130%", pin: true, scrub: 0.6, anticipatePin: 1, invalidateOnRefresh: true },
        });
        tl.fromTo(img, { "--t": corte }, { "--t": "0px", "--x": "0%", "--b": "0%", "--r": "0px", duration: 0.55, ease: "power2.inOut" }, 0)
          .fromTo(img.querySelector("img"), { scale: 1.2 }, { scale: 1, duration: 0.7 }, 0)
          .to(".hero__txt", { yPercent: -35, autoAlpha: 0, duration: 0.3 }, 0)
          .to(".hero__baja", { autoAlpha: 0, duration: 0.1 }, 0)
          .to(".hero__velo", { opacity: 1, duration: 0.3 }, 0.35)
          .fromTo(".hero__lema", { y: 50, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.2, ease: "power2.out" }, 0.5)
          .to(".cifras", { borderTopColor: "rgba(255, 255, 255, 0.35)", duration: 0.15 }, 0.52)
          .fromTo(".cifras > div", { y: 60, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.2, stagger: 0.05, ease: "power2.out" }, 0.56)
          .add(() => {
            if (contado) return;
            contado = true;
            hero.querySelectorAll<HTMLElement>("[data-n]").forEach((el) => contar(el, parseFloat(el.dataset.n!), { dur: 1.6 }));
          }, 0.58)
          .to({}, { duration: 0.2 });

        // El edificio: cada paso del texto enciende una parte
        const edi = document.querySelector<HTMLElement>(".edi")!;
        const pasos = gsap.utils.toArray<HTMLElement>(".paso");
        const poner = (n: number) => {
          edi.dataset.paso = String(n);
          pasos.forEach((p) => p.classList.toggle("on", Number(p.dataset.i) === n));
        };
        pasos.forEach((p) => {
          const n = Number(p.dataset.i);
          ScrollTrigger.create({
            trigger: p, start: ancho ? "top 60%" : "top 78%", end: ancho ? "bottom 60%" : "bottom 78%",
            onEnter: () => poner(n), onEnterBack: () => poner(n),
          });
        });
        ScrollTrigger.create({ trigger: ".edi__pasos", start: "top 85%", onLeaveBack: () => poner(0) });

        // El seguimiento de la incidencia avanza solo al llegar
        const lis = gsap.utils.toArray<HTMLElement>(".panel .pasos li");
        lis.forEach((li) => li.classList.remove("hecho", "ahora"));
        ScrollTrigger.create({
          trigger: ".panel", start: "top 75%", once: true,
          onEnter: () => lis.forEach((li, i) => gsap.delayedCall(0.4 + i * 0.75, () => {
            if (i > 0) { lis[i - 1].classList.remove("ahora"); lis[i - 1].classList.add("hecho"); }
            if (i < 3) li.classList.add("ahora");
          })),
        });
      });
    </script>

