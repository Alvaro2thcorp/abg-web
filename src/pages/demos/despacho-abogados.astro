---
import DemoBar from "../../components/demos/DemoBar.astro";

const areas = [
  { n: "01", t: "Familia", d: "Divorcios, custodias, pensiones y modificación de medidas.", c: ["Divorcio de mutuo acuerdo", "Custodia compartida", "Impago de pensión"] },
  { n: "02", t: "Herencias", d: "Testamentos, reparto entre herederos e impuesto de sucesiones.", c: ["Declaración de herederos", "Herencia sin testamento", "Conflicto entre hermanos"] },
  { n: "03", t: "Laboral", d: "Despidos, reclamaciones de salario e incapacidades.", c: ["Despido improcedente", "Finiquito mal calculado", "Incapacidad permanente"] },
  { n: "04", t: "Vivienda", d: "Alquileres, desahucios, comunidades y compraventas.", c: ["Inquilino que no paga", "Fianza no devuelta", "Vicios ocultos"] },
  { n: "05", t: "Tráfico", d: "Indemnizaciones por accidente y recursos de sanciones.", c: ["Lesiones por accidente", "Oferta baja del seguro", "Retirada de carné"] },
  { n: "06", t: "Penal", d: "Asistencia al detenido, juicios rápidos y defensa en sala.", c: ["Alcoholemia", "Denuncia recibida", "Asistencia en comisaría"] },
];

const plazos = [
  {
    id: "despido", etq: "Me han despedido",
    plazo: "20 días hábiles", desde: "desde la fecha del despido",
    nota: "Es un plazo de caducidad: si pasa, se pierde la acción. No espere a tener el finiquito para consultarnos.",
    traer: ["Carta de despido", "Contrato y últimas nóminas", "Vida laboral"]
  },
  {
    id: "accidente", etq: "He tenido un accidente de tráfico",
    plazo: "1 año", desde: "desde el alta médica o la estabilización de las lesiones",
    nota: "Antes de firmar la oferta de la aseguradora, pídanos que la revisemos. Firmarla suele cerrar la reclamación.",
    traer: ["Parte amistoso o atestado", "Informes médicos y partes de baja", "Oferta del seguro, si la hay"]
  },
  {
    id: "herencia", etq: "Ha fallecido un familiar",
    plazo: "6 meses", desde: "desde el fallecimiento, para el impuesto de sucesiones",
    nota: "Puede pedirse una prórroga dentro de los cinco primeros meses. Pasado el plazo hay recargos.",
    traer: ["Certificado de defunción", "Testamento o últimas voluntades", "Relación de bienes y cuentas"]
  },
  {
    id: "multa", etq: "Me ha llegado una multa de tráfico",
    plazo: "20 días naturales", desde: "desde la notificación",
    nota: "En ese plazo puede pagar con el 50 % de reducción o presentar alegaciones. Las dos cosas a la vez, no.",
    traer: ["Notificación completa", "Fotografías o pruebas", "Permiso de conducir"]
  },
  {
    id: "deuda", etq: "Me deben dinero",
    plazo: "5 años", desde: "desde que pudo exigirse el pago, con carácter general",
    nota: "Hay deudas con plazos más cortos. Un requerimiento fehaciente interrumpe la prescripción: conviene enviarlo cuanto antes.",
    traer: ["Contrato, factura o presupuesto aceptado", "Mensajes y correos con el deudor", "Justificantes de pagos parciales"]
  },
];

const honorarios = [
  { q: "Primera consulta", d: "45 minutos, en el despacho o por videollamada", p: "60 €", n: "Se descuenta si nos encarga el asunto" },
  { q: "Divorcio de mutuo acuerdo", d: "Convenio, demanda y ratificación", p: "desde 550 €", n: "Por cónyuge, procurador aparte" },
  { q: "Despido", d: "Conciliación y juicio", p: "12 %", n: "De lo que usted cobre. Si no cobra, no nos paga" },
  { q: "Herencia con acuerdo", d: "Cuaderno particional e impuestos", p: "desde 900 €", n: "Presupuesto cerrado tras ver la documentación" },
  { q: "Reclamación a la aseguradora", d: "Negociación y, si hace falta, demanda", p: "15 %", n: "De la indemnización obtenida" },
];

const equipo = [
  { i: "CA", n: "Carmen Alberola", r: "Socia directora", d: "Familia y herencias. Mediadora familiar." },
  { i: "PV", n: "Pablo Verdú", r: "Abogado", d: "Laboral y Seguridad Social." },
  { i: "IM", n: "Inés Maciá", r: "Abogada", d: "Vivienda, tráfico y penal." },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Albufereta Abogados · Demostración de ABG Frame</title>
    <meta name="description" content="Web de demostración de un despacho de abogados, hecha por ABG Frame." />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <DemoBar />

    <header class="cab">
      <div class="w cab__in">
        <a class="marca" href="#inicio" aria-label="Albufereta Abogados, inicio">
          <span class="marca__a">Albufereta</span>
          <span class="marca__b">Abogados · Alicante</span>
        </a>
        <nav class="nav" aria-label="Secciones">
          <a href="#areas">Áreas</a>
          <a href="#plazos">¿Qué plazo tengo?</a>
          <a href="#honorarios">Honorarios</a>
          <a href="#despacho">El despacho</a>
        </nav>
        <a class="tel" href="#contacto"><span>Llámenos</span> 965 00 00 00</a>
      </div>
    </header>

    <main id="inicio">
      <section class="hero">
        <div class="w hero__grid">
          <div>
            <p class="eyebrow">Despacho de abogados en Alicante · desde 2004</p>
            <h1>Primero le escuchamos. Después le decimos, <em>por escrito,</em> qué haríamos y cuánto cuesta.</h1>
            <p class="hero__sub">
              Familia, herencias, laboral, vivienda, tráfico y penal. Tres abogados, un solo interlocutor
              para su asunto y los honorarios claros antes de empezar.
            </p>
            <div class="hero__cta">
              <a class="btn btn--vino" href="#contacto">Pedir primera consulta</a>
              <a class="lnk" href="#plazos">Comprobar mi plazo</a>
            </div>
          </div>

          <aside class="ficha" aria-label="Primera consulta">
            <p class="ficha__t">Primera consulta</p>
            <p class="ficha__p">60 €</p>
            <p class="ficha__d">45 minutos con el abogado que llevaría su caso. Si nos lo encarga, se descuenta de los honorarios.</p>
            <ul>
              <li><span>En el despacho</span><b>L–V · 9:30 a 19:00</b></li>
              <li><span>Por videollamada</span><b>Mismo horario</b></li>
              <li><span>Detenciones</span><b>24 horas</b></li>
            </ul>
          </aside>
        </div>
      </section>

      <section id="areas" class="sec">
        <div class="w">
          <header class="cabsec">
            <p class="eyebrow">Áreas de práctica</p>
            <h2>Lo que llevamos, <em>y lo que no.</em></h2>
            <p>Seis materias. Si su asunto es de otra, se lo decimos en la primera llamada y le indicamos a quién acudir.</p>
          </header>
          <div class="areas">
            {areas.map((a) => (
              <article class="area">
                <span class="area__n">{a.n}</span>
                <h3>{a.t}</h3>
                <p>{a.d}</p>
                <ul>{a.c.map((c) => <li>{c}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="plazos" class="sec sec--noche">
        <div class="w plazos">
          <header class="cabsec cabsec--noche">
            <p class="eyebrow">El plazo corre</p>
            <h2>¿Qué le ha pasado? <em>Mire cuánto tiempo tiene.</em></h2>
            <p>Muchos asuntos se pierden por dejar pasar el plazo, no por falta de razón. Elija su situación.</p>
          </header>

          <div class="plz">
            <div class="plz__tabs" role="tablist" aria-label="Situaciones">
              {plazos.map((p, i) => (
                <button class="plz__tab" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{p.etq}</button>
              ))}
            </div>
            {plazos.map((p, i) => (
              <div class="plz__panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
                <div class="plz__cifra">
                  <p class="plz__num">{p.plazo}</p>
                  <p class="plz__desde">{p.desde}</p>
                </div>
                <div class="plz__txt">
                  <p>{p.nota}</p>
                  <p class="plz__traer">Traiga a la consulta</p>
                  <ul>{p.traer.map((t) => <li>{t}</li>)}</ul>
                  <a class="btn btn--hueso" href="#contacto">Consultar este caso</a>
                </div>
              </div>
            ))}
            <p class="plz__aviso">Información general y orientativa. Cada caso tiene particularidades que pueden cambiar el plazo.</p>
          </div>
        </div>
      </section>

      <section id="honorarios" class="sec">
        <div class="w">
          <header class="cabsec">
            <p class="eyebrow">Honorarios</p>
            <h2>Sabrá lo que cuesta <em>antes de firmar.</em></h2>
            <p>Estos son los asuntos más habituales. Para todo lo demás, presupuesto cerrado y por escrito tras la primera consulta.</p>
          </header>
          <div class="hon" role="table" aria-label="Honorarios orientativos">
            {honorarios.map((h) => (
              <div class="hon__fila" role="row">
                <div role="cell"><b>{h.q}</b><span>{h.d}</span></div>
                <div role="cell" class="hon__precio">{h.p}</div>
                <div role="cell" class="hon__nota">{h.n}</div>
              </div>
            ))}
          </div>
          <p class="hon__pie">Importes sin IVA. Tasas, procurador y peritos no incluidos; se le informan antes de cada gasto.</p>
        </div>
      </section>

      <section id="despacho" class="sec sec--tinte">
        <div class="w despacho">
          <header class="cabsec">
            <p class="eyebrow">El despacho</p>
            <h2>Tres abogados. <em>Usted habla siempre con el suyo.</em></h2>
            <p>
              No pasamos los asuntos de mano en mano. Quien le atiende en la primera consulta es quien firma
              los escritos y quien va a sala.
            </p>
          </header>
          <ul class="equipo">
            {equipo.map((e) => (
              <li>
                <span class="equipo__i" aria-hidden="true">{e.i}</span>
                <div>
                  <h3>{e.n}</h3>
                  <p class="equipo__r">{e.r} · Colegiado en Alicante</p>
                  <p>{e.d}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="contacto" class="sec">
        <div class="w contacto">
          <div>
            <p class="eyebrow">Primera consulta</p>
            <h2>Cuéntenos <em>qué ha pasado.</em></h2>
            <p class="contacto__p">
              Le llamamos en el día para darle cita. Lo que nos cuente queda amparado por el secreto profesional
              desde el primer mensaje.
            </p>
            <dl class="datos">
              <div><dt>Teléfono</dt><dd>965 00 00 00</dd></div>
              <div><dt>Urgencias penales</dt><dd>600 00 00 00 · 24 h</dd></div>
              <div><dt>Dirección</dt><dd>Avenida de Ejemplo, 24, 2.º · Alicante</dd></div>
              <div><dt>Horario</dt><dd>Lunes a viernes, 9:30 a 19:00</dd></div>
            </dl>
          </div>

          <form class="form" id="form-cita" novalidate>
            <label>Nombre<input type="text" name="nombre" autocomplete="off" placeholder="Su nombre" /></label>
            <label>Teléfono<input type="tel" name="telefono" autocomplete="off" placeholder="Para llamarle hoy" /></label>
            <label>Materia
              <select name="materia">
                {areas.map((a) => <option>{a.t}</option>)}
                <option>No lo sé</option>
              </select>
            </label>
            <label>¿Qué ha pasado?<textarea name="caso" rows="4" placeholder="Con sus palabras. No hace falta que sea largo."></textarea></label>
            <button class="btn btn--vino btn--ancho" type="submit">Pedir cita</button>
            <p class="form__ok" id="form-ok" hidden>Esto es una demostración: no se ha enviado nada. En una web real, el despacho recibiría su mensaje al momento.</p>
            <p class="form__legal">Sus datos solo se usan para darle cita.</p>
          </form>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="w pie__in">
        <p><b>Albufereta Abogados</b> · Avenida de Ejemplo, 24, 2.º · Alicante</p>
        <p>Negocio ficticio. Web de demostración creada por <a href="/">ABG Frame</a>.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var tabs = Array.prototype.slice.call(document.querySelectorAll(".plz__tab"));
        function activar(t, foco) {
          tabs.forEach(function (x) {
            var on = x === t;
            x.setAttribute("aria-selected", on ? "true" : "false");
            x.tabIndex = on ? 0 : -1;
            document.getElementById(x.getAttribute("aria-controls")).hidden = !on;
          });
          if (foco) t.focus();
        }
        tabs.forEach(function (t, i) {
          t.addEventListener("click", function () { activar(t, false); });
          t.addEventListener("keydown", function (e) {
            if (e.key === "ArrowDown" || e.key === "ArrowRight") { e.preventDefault(); activar(tabs[(i + 1) % tabs.length], true); }
            if (e.key === "ArrowUp" || e.key === "ArrowLeft") { e.preventDefault(); activar(tabs[(i - 1 + tabs.length) % tabs.length], true); }
          });
        });
        var f = document.getElementById("form-cita");
        f.addEventListener("submit", function (e) { e.preventDefault(); document.getElementById("form-ok").hidden = false; });
      })();
    </script>

    <style>
      :root {
        --papel: #F4F0E9; --papel-2: #EBE5DA; --tinta: #17130F; --tinta-2: #4A433B; --tinta-3: #776E63;
        --vino: #6E1E2A; --vino-2: #561620; --linea: #D6CEC1; --noche: #1A1512; --hueso: #EFE8DC; --oro: #B89A6A;
        --serif: "Newsreader", Georgia, serif; --sans: "IBM Plex Sans", system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--papel); color: var(--tinta); font-family: var(--sans); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
      .w { width: 100%; max-width: 1180px; margin: 0 auto; padding-inline: clamp(1.25rem, 4vw, 3rem); }
      h1, h2, h3 { font-family: var(--serif); font-weight: 400; margin: 0; letter-spacing: -0.015em; }
      em { font-style: italic; color: var(--vino); }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--vino); outline-offset: 3px; }
      .eyebrow { font-size: 0.74rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--vino); margin: 0 0 1.1rem; }

      .cab { border-bottom: 1px solid var(--linea); background: var(--papel); position: sticky; top: 0; z-index: 10; }
      .cab__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 72px; }
      .marca { text-decoration: none; display: grid; line-height: 1.05; }
      .marca__a { font-family: var(--serif); font-size: 1.55rem; letter-spacing: -0.02em; }
      .marca__b { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--tinta-3); margin-top: 0.2rem; }
      .nav { display: flex; gap: 1.9rem; }
      .nav a { font-size: 0.92rem; text-decoration: none; color: var(--tinta-2); padding: 0.4rem 0; border-bottom: 1px solid transparent; }
      .nav a:hover { color: var(--vino); border-color: var(--vino); }
      .tel { text-decoration: none; font-family: var(--serif); font-size: 1.2rem; white-space: nowrap; }
      .tel span { display: block; font-family: var(--sans); font-size: 0.64rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--tinta-3); text-align: right; }

      .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0.8rem 1.6rem; font-family: var(--sans); font-weight: 500; font-size: 0.95rem; text-decoration: none; border: 1px solid transparent; border-radius: 2px; cursor: pointer; transition: background 0.2s, color 0.2s; }
      .btn--vino { background: var(--vino); color: #fff; }
      .btn--vino:hover { background: var(--vino-2); }
      .btn--hueso { background: var(--hueso); color: var(--tinta); }
      .btn--hueso:hover { background: #fff; }
      .btn--ancho { width: 100%; }
      .lnk { font-weight: 500; font-size: 0.95rem; text-decoration: none; border-bottom: 1px solid var(--tinta); padding-bottom: 2px; }
      .lnk:hover { color: var(--vino); border-color: var(--vino); }

      .hero { padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3.5rem, 7vw, 5.5rem); border-bottom: 1px solid var(--linea); }
      .hero__grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; }
      .hero h1 { font-size: clamp(2.2rem, 4.5vw, 3.9rem); line-height: 1.06; text-wrap: balance; }
      .hero__sub { font-size: clamp(1rem, 1.3vw, 1.12rem); color: var(--tinta-2); max-width: 52ch; margin: 1.6rem 0 0; }
      .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 2.1rem; }
      .ficha { background: var(--noche); color: var(--hueso); padding: 2rem 1.9rem; border-radius: 2px; }
      .ficha__t { font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--oro); margin: 0; }
      .ficha__p { font-family: var(--serif); font-size: 4rem; line-height: 1; letter-spacing: -0.03em; margin: 0.6rem 0 0.9rem; }
      .ficha__d { font-size: 0.93rem; color: #C9BFB0; margin: 0 0 1.4rem; }
      .ficha ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid #3A322B; }
      .ficha li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid #3A322B; font-size: 0.86rem; }
      .ficha li span { color: #A99F91; }
      .ficha li b { font-weight: 500; }

      .sec { padding: clamp(4rem, 8vw, 6.5rem) 0; }
      .sec--tinte { background: var(--papel-2); }
      .sec--noche { background: var(--noche); color: var(--hueso); }
      .cabsec { max-width: 60ch; margin-bottom: clamp(2.25rem, 4vw, 3.25rem); }
      .cabsec h2, .contacto h2 { font-size: clamp(1.9rem, 3.6vw, 3rem); line-height: 1.08; text-wrap: balance; }
      .cabsec p:last-child { color: var(--tinta-2); margin: 1rem 0 0; }
      .cabsec--noche .eyebrow { color: var(--oro); }
      .cabsec--noche em { color: #D9A7A0; }
      .cabsec--noche p:last-child { color: #BDB3A5; }

      .areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--tinta); border-left: 1px solid var(--linea); }
      .area { padding: 1.9rem 1.75rem 2.1rem; border-right: 1px solid var(--linea); border-bottom: 1px solid var(--linea); }
      .area__n { font-family: var(--serif); font-style: italic; color: var(--vino); font-size: 1rem; }
      .area h3 { font-size: 1.75rem; margin: 0.35rem 0 0.6rem; }
      .area p { margin: 0 0 1.1rem; color: var(--tinta-2); font-size: 0.95rem; }
      .area ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
      .area li { font-size: 0.86rem; color: var(--tinta-3); padding-left: 1rem; position: relative; }
      .area li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 6px; height: 1px; background: var(--vino); }

      .plz { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr); gap: 0 clamp(1.5rem, 4vw, 3.5rem); }
      .plz__tabs { display: grid; align-content: start; border-top: 1px solid #3A322B; }
      .plz__tab { text-align: left; background: none; border: 0; border-bottom: 1px solid #3A322B; color: #BDB3A5; font-family: var(--serif); font-size: 1.25rem; padding: 1rem 0.25rem 1rem 1.1rem; cursor: pointer; position: relative; transition: color 0.2s; }
      .plz__tab::before { content: ""; position: absolute; left: 0; top: 50%; width: 0; height: 1px; background: var(--oro); transition: width 0.2s; }
      .plz__tab:hover { color: var(--hueso); }
      .plz__tab[aria-selected="true"] { color: var(--hueso); }
      .plz__tab[aria-selected="true"]::before { width: 0.7rem; }
      .plz__tab:focus-visible { outline-color: var(--oro); }
      .plz__panel { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: start; border-top: 1px solid #3A322B; padding-top: 1.75rem; }
      .plz__panel[hidden] { display: none; }
      .plz__num { font-family: var(--serif); font-size: clamp(2.6rem, 5vw, 4.2rem); line-height: 0.95; letter-spacing: -0.03em; margin: 0; color: #fff; }
      .plz__desde { font-size: 0.9rem; color: var(--oro); margin: 0.8rem 0 0; }
      .plz__txt p { margin: 0 0 1.25rem; color: #D3CABC; }
      .plz__traer { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--oro) !important; margin-bottom: 0.6rem !important; }
      .plz__txt ul { list-style: none; margin: 0 0 1.6rem; padding: 0; display: grid; gap: 0.4rem; }
      .plz__txt li { font-size: 0.93rem; padding-left: 1.1rem; position: relative; color: var(--hueso); }
      .plz__txt li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 7px; height: 1px; background: var(--oro); }
      .plz__aviso { grid-column: 2; font-size: 0.78rem; color: #8F867A; margin: 1.75rem 0 0; }

      .hon { border-top: 1px solid var(--tinta); }
      .hon__fila { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.5fr) minmax(0, 1fr); gap: 1.5rem; align-items: baseline; padding: 1.35rem 0; border-bottom: 1px solid var(--linea); }
      .hon__fila b { display: block; font-family: var(--serif); font-weight: 400; font-size: 1.35rem; letter-spacing: -0.01em; }
      .hon__fila span { font-size: 0.9rem; color: var(--tinta-3); }
      .hon__precio { font-family: var(--serif); font-size: 1.7rem; color: var(--vino); white-space: nowrap; font-variant-numeric: lining-nums tabular-nums; }
      .hon__nota { font-size: 0.9rem; color: var(--tinta-2); }
      .hon__pie { font-size: 0.82rem; color: var(--tinta-3); margin: 1.25rem 0 0; }

      .despacho { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
      .despacho .cabsec { margin-bottom: 0; }
      .equipo { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--tinta); }
      .equipo li { display: flex; gap: 1.4rem; align-items: flex-start; padding: 1.5rem 0; border-bottom: 1px solid #CFC6B7; }
      .equipo__i { flex: none; width: 58px; height: 58px; border-radius: 50%; border: 1px solid var(--vino); color: var(--vino); display: grid; place-items: center; font-family: var(--serif); font-size: 1.2rem; }
      .equipo h3 { font-size: 1.45rem; }
      .equipo__r { font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tinta-3); margin: 0.25rem 0 0.4rem; }
      .equipo p { margin: 0; font-size: 0.95rem; color: var(--tinta-2); }

      .contacto { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
      .contacto__p { color: var(--tinta-2); max-width: 48ch; margin: 1.1rem 0 2rem; }
      .datos { margin: 0; border-top: 1px solid var(--linea); }
      .datos div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--linea); }
      .datos dt { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tinta-3); padding-top: 0.2rem; }
      .datos dd { margin: 0; }
      .form { background: #FBF9F5; border: 1px solid var(--linea); padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: 1.1rem; border-radius: 2px; }
      .form label { display: grid; gap: 0.4rem; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tinta-3); }
      .form input, .form select, .form textarea { font: inherit; font-size: 1rem; letter-spacing: 0; text-transform: none; color: var(--tinta); background: #fff; border: 1px solid #C9C0B2; border-radius: 2px; padding: 0.8rem 0.9rem; width: 100%; }
      .form textarea { resize: vertical; }
      .form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--vino); outline-offset: 1px; border-color: var(--vino); }
      .form__ok { margin: 0; padding: 0.9rem 1rem; background: #F1E4E2; border-left: 3px solid var(--vino); font-size: 0.9rem; color: var(--tinta); }
      .form__legal { margin: 0; font-size: 0.78rem; color: var(--tinta-3); text-align: center; }

      .pie { background: var(--noche); color: #A99F91; padding: 1.75rem 0; font-size: 0.85rem; }
      .pie__in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; }
      .pie p { margin: 0; }
      .pie b { color: var(--hueso); font-weight: 500; }
      .pie a { color: var(--hueso); }

      @media (max-width: 980px) {
        .nav { display: none; }
        .hero__grid, .despacho, .contacto { grid-template-columns: minmax(0, 1fr); }
        .hero__grid { align-items: start; }
        .areas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .plz { grid-template-columns: minmax(0, 1fr); }
        .plz__tabs { margin-bottom: 0.5rem; }
        .plz__panel { border-top: 0; }
        .plz__aviso { grid-column: 1; }
      }
      @media (max-width: 640px) {
        .cab__in { min-height: 62px; }
        .marca__a { font-size: 1.3rem; }
        .tel { font-size: 1.05rem; }
        .areas { grid-template-columns: minmax(0, 1fr); }
        .plz__tab { font-size: 1.1rem; padding-block: 0.85rem; }
        .plz__panel { grid-template-columns: minmax(0, 1fr); }
        .hon__fila { grid-template-columns: minmax(0, 1fr) auto; gap: 0.4rem 1rem; }
        .hon__nota { grid-column: 1 / -1; }
        .datos div { grid-template-columns: minmax(0, 1fr); gap: 0.15rem; }
        .hero__cta .btn { width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
    </style>
  </body>
</html>
