---
import DemoBar from "../../components/demos/DemoBar.astro";

const servicios = [
  { t: "Fiscal", d: "IVA, IRPF, sociedades y renta. Presentamos cada modelo en plazo y le avisamos antes, no después." },
  { t: "Laboral", d: "Altas, nóminas, contratos y seguros sociales. Para un empleado o para cuarenta." },
  { t: "Contable", d: "Sus libros al día y unas cuentas que se entienden, con una reunión cada trimestre." },
  { t: "Vehículos y tráfico", d: "Transferencias, matriculaciones y bajas en el día. Sin colas en Tráfico." },
  { t: "Herencias", d: "Declaración de herederos, impuesto de sucesiones y cambio de titularidad, de principio a fin." },
  { t: "Extranjería", d: "NIE, residencia y arraigo. Le acompañamos a la cita si hace falta." },
];
const plazos = [
  { f: "20 oct", q: "3.er trimestre", m: "Modelos 303, 130, 111 y 115", n: "IVA, pago fraccionado de IRPF y retenciones" },
  { f: "20 ene", q: "4.º trimestre", m: "Modelos 111 y 115", n: "Retenciones de nóminas, profesionales y alquileres" },
  { f: "30 ene", q: "4.º trimestre", m: "Modelos 303, 130 y 390", n: "IVA, IRPF y resumen anual de IVA" },
  { f: "Abr – jun", q: "Renta", m: "Modelo 100", n: "Campaña de la renta y patrimonio" },
  { f: "25 jul", q: "Sociedades", m: "Modelo 200", n: "Impuesto sobre sociedades del ejercicio anterior" },
];
const equipo = [
  { i: "MS", n: "Mercedes Soler", r: "Gestora administrativa colegiada", d: "Dirige el despacho. Fiscal y herencias." },
  { i: "JB", n: "Joaquín Beltrá", r: "Graduado social", d: "Nóminas, contratos y Seguridad Social." },
  { i: "LA", n: "Lucía Aracil", r: "Técnica contable", d: "Contabilidad de autónomos y sociedades." },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Gestoría Serra Grossa · Demostración de ABG Frame</title>
    <meta name="description" content="Web de demostración de una gestoría administrativa, hecha por ABG Frame." />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <DemoBar />

    <div class="util">
      <div class="w util__in">
        <span>Lunes a viernes · 9:00–14:00 y 16:30–19:00</span>
        <span>Tel. 965 00 00 00 · Calle de Ejemplo, 12 · Alicante</span>
      </div>
    </div>

    <header class="cab">
      <div class="w cab__in">
        <a class="marca" href="#inicio" aria-label="Gestoría Serra Grossa, inicio">
          <span class="marca__sg">SG</span>
          <span class="marca__txt">Gestoría<br /><b>Serra Grossa</b></span>
        </a>
        <nav class="nav" aria-label="Secciones">
          <a href="#servicios">Servicios</a>
          <a href="#calendario">Calendario fiscal</a>
          <a href="#documentacion">Enviar documentación</a>
          <a href="#despacho">El despacho</a>
        </nav>
        <a class="btn btn--pino" href="#contacto">Pedir cita</a>
      </div>
    </header>

    <main id="inicio">
      <section class="hero">
        <div class="w hero__grid">
          <div>
            <p class="sobre">Gestoría administrativa · Alicante, desde 1989</p>
            <h1>Sus papeles al día.<br /><em>Y usted, a lo suyo.</em></h1>
            <p class="lead">
              Llevamos la parte fiscal, laboral y contable de autónomos y pequeñas empresas de Alicante.
              Le avisamos de cada plazo con tiempo y recogemos su documentación sin que tenga que venir.
            </p>
            <div class="hero__cta">
              <a class="btn btn--pino" href="#contacto">Pedir cita</a>
              <a class="enlace" href="#documentacion">Enviar documentación</a>
            </div>
          </div>

          <aside class="plazo-card" aria-label="Próximos plazos">
            <p class="plazo-card__t">Próximos plazos</p>
            <ol>
              {plazos.slice(0, 3).map((p) => (
                <li>
                  <span class="plazo-card__f">{p.f}</span>
                  <span><b>{p.m}</b><small>{p.n}</small></span>
                </li>
              ))}
            </ol>
            <a class="enlace enlace--claro" href="#calendario">Ver el calendario completo</a>
          </aside>
        </div>
      </section>

      <section class="cifras" aria-label="El despacho en cifras">
        <div class="w cifras__grid">
          <div><b>37</b><span>años en el mismo despacho</span></div>
          <div><b>840</b><span>clientes entre autónomos y empresas</span></div>
          <div><b>6</b><span>personas, todas con nombre y apellidos</span></div>
        </div>
      </section>

      <section id="servicios" class="sec">
        <div class="w">
          <p class="sobre">Servicios</p>
          <h2>Lo que hacemos <em>cada día.</em></h2>
          <div class="servs">
            {servicios.map((s) => (
              <article>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="calendario" class="sec sec--pino">
        <div class="w cal__grid">
          <div>
            <p class="sobre sobre--laton">Calendario fiscal</p>
            <h2>Las fechas que <em>no puede saltarse.</em></h2>
            <p class="lead lead--claro">
              Una semana antes de cada plazo recibe un aviso con la documentación que nos falta.
              Así nadie corre el último día.
            </p>
            <div class="aviso">
              <b>Verifactu, en 2027</b>
              <p>Las sociedades deberán facturar con un programa adaptado desde el 1 de enero de 2027 y los autónomos desde el 1 de julio. Le dejamos preparado antes de la fecha.</p>
            </div>
          </div>
          <div class="tabla" role="region" aria-label="Calendario fiscal" tabindex="0">
            <table>
              <thead><tr><th>Fecha límite</th><th>Periodo</th><th>Qué se presenta</th></tr></thead>
              <tbody>
                {plazos.map((p) => (
                  <tr><td class="f">{p.f}</td><td>{p.q}</td><td><b>{p.m}</b><small>{p.n}</small></td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="documentacion" class="sec">
        <div class="w doc__grid">
          <div>
            <p class="sobre">Sin venir al despacho</p>
            <h2>Envíenos sus facturas <em>desde el móvil.</em></h2>
            <ol class="pasos">
              <li><b>Haga una foto</b> a la factura o adjunte el PDF.</li>
              <li><b>Nos llega al momento</b>, ordenada por trimestre y a su nombre.</li>
              <li><b>Le confirmamos</b> qué hemos recibido y qué falta.</li>
            </ol>
          </div>
          <form class="subida" onsubmit="event.preventDefault(); this.querySelector('output').hidden = false;">
            <label for="sg-nombre">Nombre o empresa</label>
            <input id="sg-nombre" type="text" placeholder="Ej.: Reformas Llorens, S.L." />
            <label for="sg-trim">Trimestre</label>
            <select id="sg-trim"><option>3.er trimestre de 2026</option><option>4.º trimestre de 2026</option></select>
            <div class="zona">
              <b>Arrastre aquí sus facturas</b>
              <span>o pulse para elegir archivos · PDF, JPG o PNG</span>
            </div>
            <button class="btn btn--pino" type="submit">Enviar documentación</button>
            <output hidden>Demostración: aquí sus archivos llegarían al despacho y recibiría un justificante por correo.</output>
          </form>
        </div>
      </section>

      <section id="despacho" class="sec sec--crema">
        <div class="w">
          <p class="sobre">El despacho</p>
          <h2>Quién le coge <em>el teléfono.</em></h2>
          <div class="equipo">
            {equipo.map((e) => (
              <article>
                <span class="mono" aria-hidden="true">{e.i}</span>
                <h3>{e.n}</h3>
                <p class="rol">{e.r}</p>
                <p>{e.d}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contacto" class="sec">
        <div class="w cont__grid">
          <div>
            <p class="sobre">Contacto</p>
            <h2>Pida cita. <em>Le llamamos hoy.</em></h2>
            <dl class="datos">
              <div><dt>Dirección</dt><dd>Calle de Ejemplo, 12, entresuelo<br />03001 Alicante</dd></div>
              <div><dt>Teléfono</dt><dd>965 00 00 00</dd></div>
              <div><dt>Horario</dt><dd>Lunes a viernes<br />9:00–14:00 y 16:30–19:00</dd></div>
            </dl>
          </div>
          <form class="cita" onsubmit="event.preventDefault(); this.querySelector('output').hidden = false;">
            <label for="sg-c-nombre">Nombre</label>
            <input id="sg-c-nombre" type="text" />
            <label for="sg-c-tel">Teléfono</label>
            <input id="sg-c-tel" type="tel" />
            <label for="sg-c-tema">¿En qué podemos ayudarle?</label>
            <select id="sg-c-tema">{servicios.map((s) => <option>{s.t}</option>)}</select>
            <button class="btn btn--pino" type="submit">Pedir cita</button>
            <output hidden>Demostración: aquí la solicitud llegaría al despacho y usted recibiría la confirmación.</output>
          </form>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="w pie__in">
        <span>Gestoría Serra Grossa · Negocio ficticio de demostración</span>
        <a href="/">Web hecha por ABG Frame</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --pino: #1D3B2F; --pino-2: #16302A; --marfil: #F5F1E6; --papel: #FBF9F3; --laton: #9A7B3F; --laton-claro: #D2B87C;
    --tinta: #1B1F1C; --gris: #58615A; --linea: #DDD6C4;
    --serif: "Libre Caslon Text", Georgia, serif; --sans: "Public Sans", system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--papel); color: var(--tinta); font-family: var(--sans); font-size: 17px; line-height: 1.6; }
  .w { max-width: 1160px; margin: 0 auto; padding-inline: clamp(1.25rem, 4.5vw, 3rem); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 400; margin: 0; text-wrap: balance; }
  h1 { font-size: clamp(2.5rem, 5.6vw, 4.4rem); line-height: 1.04; letter-spacing: -0.015em; }
  h2 { font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1.1; letter-spacing: -0.01em; }
  h1 em, h2 em { font-style: italic; color: var(--laton); }
  .sobre { font-size: 0.76rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--laton); margin: 0 0 1.1rem; }
  .sobre--laton { color: var(--laton-claro); }
  .lead { font-size: 1.1rem; color: var(--gris); max-width: 52ch; margin: 1.5rem 0 0; }
  .lead--claro { color: #C9D3CC; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0.75rem 1.5rem; border-radius: 2px; border: 0; font-family: var(--sans); font-weight: 600; font-size: 0.95rem; text-decoration: none; cursor: pointer; transition: background 0.2s; }
  .btn--pino { background: var(--pino); color: var(--marfil); }
  .btn--pino:hover { background: var(--pino-2); }
  .enlace { color: var(--pino); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--pino); padding-bottom: 2px; }
  .enlace--claro { color: var(--marfil); border-color: var(--laton-claro); }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--laton); outline-offset: 3px; }

  .util { background: var(--pino); color: #D7DFD9; font-size: 0.82rem; }
  .util__in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.25rem 1.5rem; padding-block: 0.55rem; }
  .cab { background: var(--papel); border-bottom: 1px solid var(--linea); position: sticky; top: 0; z-index: 10; }
  .cab__in { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 0.9rem; }
  .marca { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; color: var(--tinta); }
  .marca__sg { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--laton); color: var(--laton); font-family: var(--serif); font-size: 1.05rem; letter-spacing: 0.04em; }
  .marca__txt { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; line-height: 1.35; color: var(--gris); }
  .marca__txt b { font-family: var(--serif); font-weight: 400; font-size: 1.15rem; letter-spacing: 0; text-transform: none; color: var(--tinta); }
  .nav { display: flex; gap: 1.75rem; }
  .nav a { color: var(--tinta); text-decoration: none; font-size: 0.93rem; font-weight: 500; }
  .nav a:hover { color: var(--laton); }

  .hero { padding-block: clamp(3.5rem, 7vw, 6rem); background: linear-gradient(var(--papel), var(--marfil)); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero__cta { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.75rem; margin-top: 2.25rem; }
  .plazo-card { background: var(--pino); color: var(--marfil); padding: 1.75rem; border-top: 3px solid var(--laton); }
  .plazo-card__t { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--laton-claro); margin: 0 0 1rem; }
  .plazo-card ol { list-style: none; margin: 0 0 1.5rem; padding: 0; }
  .plazo-card li { display: grid; grid-template-columns: 5.2rem 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid rgba(245, 241, 230, 0.16); }
  .plazo-card__f { font-family: var(--serif); font-size: 1.45rem; line-height: 1.1; color: var(--laton-claro); }
  .plazo-card b { display: block; font-weight: 600; font-size: 0.95rem; }
  .plazo-card small, .tabla small { display: block; font-size: 0.84rem; color: #B9C6BD; margin-top: 0.15rem; }

  .cifras { background: var(--marfil); border-block: 1px solid var(--linea); }
  .cifras__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cifras__grid div { padding: 1.75rem 1.5rem 1.75rem 0; display: flex; align-items: baseline; gap: 0.9rem; }
  .cifras__grid div + div { padding-left: 1.5rem; border-left: 1px solid var(--linea); }
  .cifras b { font-family: var(--serif); font-weight: 400; font-size: 2.6rem; line-height: 1; color: var(--pino); font-variant-numeric: lining-nums; }
  .cifras span { font-size: 0.92rem; color: var(--gris); line-height: 1.35; }

  .sec { padding-block: clamp(4rem, 8vw, 6.5rem); }
  .sec--pino { background: var(--pino); color: var(--marfil); }
  .sec--pino h2 em { color: var(--laton-claro); }
  .sec--crema { background: var(--marfil); }
  .servs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 3rem; border-top: 1px solid var(--tinta); }
  .servs article { padding: 1.75rem 1.75rem 1.75rem 0; border-bottom: 1px solid var(--linea); }
  .servs h3 { font-size: 1.45rem; margin-bottom: 0.6rem; }
  .servs p { margin: 0; color: var(--gris); font-size: 0.98rem; }

  .cal__grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .aviso { margin-top: 2rem; padding: 1.25rem 1.4rem; border: 1px solid rgba(210, 184, 124, 0.5); }
  .aviso b { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; color: var(--laton-claro); }
  .aviso p { margin: 0.5rem 0 0; font-size: 0.95rem; color: #C9D3CC; }
  .tabla { overflow-x: auto; background: var(--papel); color: var(--tinta); }
  .tabla table { width: 100%; min-width: 520px; border-collapse: collapse; }
  .tabla th { text-align: left; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gris); padding: 1rem 1.25rem; border-bottom: 1px solid var(--tinta); }
  .tabla td { padding: 1rem 1.25rem; border-bottom: 1px solid var(--linea); font-size: 0.95rem; vertical-align: top; }
  .tabla td.f { font-family: var(--serif); font-size: 1.3rem; color: var(--pino); white-space: nowrap; }
  .tabla small { color: var(--gris); }
  .tabla tr:last-child td { border-bottom: 0; }

  .doc__grid, .cont__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .pasos { margin: 2rem 0 0; padding: 0; list-style: none; counter-reset: p; }
  .pasos li { counter-increment: p; position: relative; padding: 1.1rem 0 1.1rem 3.2rem; border-top: 1px solid var(--linea); color: var(--gris); }
  .pasos li::before { content: counter(p); position: absolute; left: 0; top: 0.85rem; font-family: var(--serif); font-size: 1.7rem; color: var(--laton); }
  .pasos b { color: var(--tinta); font-weight: 600; }
  form { display: grid; gap: 0.5rem; background: var(--marfil); border: 1px solid var(--linea); padding: clamp(1.25rem, 3vw, 2rem); }
  label { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; margin-top: 0.6rem; }
  input, select { font: inherit; font-size: 1rem; padding: 0.7rem 0.8rem; border: 1px solid #C9C1AC; background: var(--papel); color: var(--tinta); border-radius: 2px; width: 100%; }
  .zona { margin: 1rem 0; padding: 1.75rem 1rem; text-align: center; border: 1.5px dashed var(--laton); background: var(--papel); }
  .zona b { display: block; font-family: var(--serif); font-weight: 400; font-size: 1.2rem; }
  .zona span { font-size: 0.86rem; color: var(--gris); }
  form .btn { margin-top: 0.75rem; }
  output { display: block; margin-top: 0.75rem; padding: 0.8rem 1rem; background: var(--papel); border-left: 3px solid var(--laton); font-size: 0.9rem; color: var(--gris); }
  output[hidden] { display: none; }

  .equipo { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; }
  .equipo article { border-top: 1px solid var(--tinta); padding-top: 1.5rem; }
  .mono { width: 64px; height: 64px; display: grid; place-items: center; background: var(--pino); color: var(--laton-claro); font-family: var(--serif); font-size: 1.3rem; margin-bottom: 1.25rem; }
  .equipo h3 { font-size: 1.4rem; }
  .equipo .rol { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--laton); margin: 0.4rem 0 0.7rem; }
  .equipo p { margin: 0; color: var(--gris); font-size: 0.97rem; }

  .datos { margin: 2rem 0 0; }
  .datos div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--linea); }
  .datos dt { font-size: 0.76rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--laton); padding-top: 0.2rem; }
  .datos dd { margin: 0; }

  .pie { background: var(--pino-2); color: #B9C6BD; font-size: 0.86rem; }
  .pie__in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding-block: 1.5rem; }
  .pie a { color: var(--marfil); }

  @media (max-width: 900px) {
    .nav { display: none; }
    .hero__grid, .cal__grid, .doc__grid, .cont__grid { grid-template-columns: minmax(0, 1fr); }
    .servs, .equipo { grid-template-columns: minmax(0, 1fr); }
    .servs article { padding-right: 0; }
    .cifras__grid { grid-template-columns: minmax(0, 1fr); }
    .cifras__grid div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--linea); }
    .util__in span:first-child { display: none; }
  }
</style>
