---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Cabecera from "../components/site/Cabecera.astro";
import Planes from "../components/site/Planes.astro";
import Cuidado from "../components/site/Cuidado.astro";
import FAQ from "../components/site/FAQ.astro";

const title = "Servicios y precios de diseño web en Alicante | ABG Frame";
const description =
    "Tres planes de web con precio cerrado: Esencial 590 €, Profesional 1.190 € y Completa 1.990 €. Mantenimiento desde 49 €/mes y Rescate Web por 290 €.";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Diseño y desarrollo web en Alicante",
    provider: {
        "@type": "LocalBusiness",
        name: "ABG Frame",
        image: "https://abgframe.com/images/abglogo.png",
        address: {
            "@type": "PostalAddress",
            addressLocality: "Alicante",
            addressCountry: "ES",
        },
    },
    hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios ABG Frame",
        itemListElement: [
            {
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: "Web Profesional",
                    description: "Web de hasta 6 páginas publicada en 7 días hábiles, con textos, SEO local, formulario, WhatsApp y textos legales.",
                },
            },
            {
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: "Rescate Web",
                    description: "Puesta a punto de webs WordPress o Shopify: seguridad, velocidad, copias y formularios, en 72 horas.",
                },
            },
            {
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: "Plan Cuidado",
                    description: "Mantenimiento mensual: hosting, dominio, actualizaciones, copias de seguridad y cambios pequeños.",
                },
            },
        ],
    },
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: "https://abgframe.com" },
        { "@type": "ListItem", position: 2, name: "Servicios", item: "https://abgframe.com/servicios" },
    ],
};
---

<Layout title={title} description={description}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <Navbar client:load />

    <main>
        <Cabecera
            eyebrow="Servicios y precios"
            lead="Tres planes de web, un mantenimiento mensual y un arreglo rápido para quien ya tiene página. Todo con el precio a la vista."
        >
            Precio cerrado, <em>por escrito.</em>
        </Cabecera>

        <Planes conCabecera={false} />
        <Cuidado />
        <FAQ />
    </main>
</Layout>
